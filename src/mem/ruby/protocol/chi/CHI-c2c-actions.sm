// CHI C2C Gateway action definitions
// Phase 6: WritePush combining

////////////////////////////////////////////////////////////////////////////
// Credit management actions
////////////////////////////////////////////////////////////////////////////

action(consumeReqCredit, "crdReq",
       desc="Consume one REQ credit for outbound request") {
  assert(is_valid(tbe));
  creditMgr.consumeReqCredit(tbe.resPlane);
}

action(consumeRspCredit, "crdRsp",
       desc="Consume one RSP credit for outbound response") {
  creditMgr.consumeRspCredit();
}

action(consumeSnpCredit, "crdSnp",
       desc="Consume one SNP credit for outbound snoop") {
  creditMgr.consumeSnpCredit();
}

action(consumeDatCredit, "crdDat",
       desc="Consume one DAT credit for outbound data") {
  creditMgr.consumeDatCredit();
}

action(returnReqCredit, "retReq",
       desc="Return one REQ credit on inbound request dequeue") {
  creditMgr.returnReqCredit();
}

action(returnRspCredit, "retRsp",
       desc="Return one RSP credit on inbound response dequeue") {
  creditMgr.returnRspCredit();
}

action(returnSnpCredit, "retSnp",
       desc="Return one SNP credit on inbound snoop dequeue") {
  creditMgr.returnSnpCredit();
}

action(returnDatCredit, "retDat",
       desc="Return one DAT credit on inbound data dequeue") {
  creditMgr.returnDatCredit();
}

////////////////////////////////////////////////////////////////////////////
// TBE management actions
////////////////////////////////////////////////////////////////////////////

action(checkAllocateTBE, desc="Check TBE availability and move to reqRdy") {
  if (storTBEs.areNSlotsAvailable(1)) {
    storTBEs.incrementReserved();
    peek(reqInPort, CHIRequestMsg) {
      DPRINTF(RubySlicc,
              "checkAllocateTBE grant: addr=%#x type=%s requestor=%s allowRetry=%d\n",
              in_msg.addr, in_msg.type, in_msg.requestor,
              in_msg.allowRetry);
      enqueue(reqRdyOutPort, CHIRequestMsg, 0) {
        out_msg := in_msg;
      }
    }
  } else {
    peek(reqInPort, CHIRequestMsg) {
      assert(in_msg.allowRetry);
      DPRINTF(RubySlicc,
              "checkAllocateTBE retry: addr=%#x type=%s requestor=%s\n",
              in_msg.addr, in_msg.type, in_msg.requestor);
      tbeFullRetries := tbeFullRetries + 1;
      enqueue(retryTriggerOutPort, RetryTriggerMsg, 0) {
        out_msg.addr := in_msg.addr;
        out_msg.event := Event:SendRetryAck;
        out_msg.retryDest := in_msg.requestor;
      }
      retryQueue.emplace(in_msg.addr, in_msg.requestor);
    }
  }
  reqInPort.dequeue(clockEdge());
}

action(checkAllocateTBE_withCredit, desc="TBE alloc after credit granted") {
  peek(reqInPort, CHIRequestMsg) {
    assert(in_msg.allowRetry == false);
    DPRINTF(RubySlicc,
            "checkAllocateTBE_withCredit: addr=%#x type=%s requestor=%s\n",
            in_msg.addr, in_msg.type, in_msg.requestor);
    enqueue(reqRdyOutPort, CHIRequestMsg, 0) {
      out_msg := in_msg;
    }
  }
  reqInPort.dequeue(clockEdge());
}

action(allocateTBE, "atbe", desc="Allocate TBE for a transaction") {
  storTBEs.decrementReserved();
  assert(storTBEs.areNSlotsAvailable(1));
  int slot := storTBEs.addEntryToNewSlot();
  Addr key := tbeSlotKey(slot);
  TBEs.allocate(key);
  set_tbe(TBEs[key]);
  tbe.storSlot := slot;
  tbe.addr := address;
  tbe.allocTime := curTick();
  clearTBEDefaults(tbe);
  txnKeyTable.bindAddress(address, key);
}

// Mark TBE as outbound (local→remote). Called after allocateTBE for
// all outbound flows so port handlers can select _Out events.
action(setOutbound, "sout", desc="Mark TBE as outbound transaction") {
  assert(is_valid(tbe));
  tbe.isOutbound := true;
}

action(deallocateTBE, "dtbe", desc="Deallocate TBE") {
  assert(is_valid(tbe));
  // Record per-transaction latency stats (FR-C03)
  Tick txnLifetime := curTick() - tbe.allocTime;
  txnLatencyCount := txnLatencyCount + 1;
  txnLatencySum := txnLatencySum + txnLifetime;
  if (txnLifetime < txnLatencyMin) {
    txnLatencyMin := txnLifetime;
  }
  if (txnLifetime > txnLatencyMax) {
    txnLatencyMax := txnLifetime;
  }
  DPRINTF(RubySlicc, "C2C TBE dealloc addr=%#x lifetime=%llu ticks\n",
          address, txnLifetime);
  Addr key := tbeKey(tbe);
  txnKeyTable.eraseKey(key);
  storTBEs.removeEntryFromSlot(tbe.storSlot);
  TBEs.deallocate(key);
  unset_tbe();
  // Check if a retrying requester is waiting for credit
  if (retryQueue.empty() == false) {
    assert(storTBEs.areNSlotsAvailable(1));
    storTBEs.incrementReserved();
    RetryQueueEntry e := retryQueue.next();
    retryQueue.pop();
    enqueue(retryTriggerOutPort, RetryTriggerMsg, 0) {
      out_msg.addr := e.addr;
      out_msg.retryDest := e.retryDest;
      out_msg.event := Event:SendPCrdGrant;
    }
  }
}

action(allocateSnpTBE, "asnptbe", desc="Allocate snoop TBE") {
  // Snoop TBEs are reserved in the snoop port handlers before the
  // transition fires, so consume that reservation before allocating.
  storSnpTBEs.decrementReserved();
  assert(storSnpTBEs.areNSlotsAvailable(1));
  snpTBEs.allocate(address);
  set_tbe(snpTBEs[address]);
  tbe.storSlot := storSnpTBEs.addEntryToNewSlot();
  tbe.addr := address;
  tbe.allocTime := curTick();
  clearTBEDefaults(tbe);
  tbe.isSnoop := true;
}

action(deallocateSnpTBE, "dsnptbe", desc="Deallocate snoop TBE") {
  assert(is_valid(tbe));
  DPRINTF(RubySlicc, "C2C snpTBE dealloc addr=%#x lifetime=%llu ticks\n",
          address, curTick() - tbe.allocTime);
  storSnpTBEs.removeEntryFromSlot(tbe.storSlot);
  snpTBEs.deallocate(address);
  unset_tbe();
  wakeUpAllBuffers(address);
}

////////////////////////////////////////////////////////////////////////////
// ID recording actions
////////////////////////////////////////////////////////////////////////////

action(recordLocalIDs_fromReq, "rlid", desc="Record local IDs from request") {
  assert(is_valid(tbe));
  peek(reqRdyInPort, CHIRequestMsg) {
    Addr key := tbeKey(tbe);
    tbe.reqType := in_msg.type;
    tbe.localSrcID := in_msg.requestor;
    tbe.localFwdRequestor := in_msg.fwdRequestor;
    tbe.localTxnID := in_msg.txnId;
    tbe.remoteSrcID := machineID;
    txnKeyTable.bindLocal(tbe.localSrcID, tbe.localTxnID, key);
    txnKeyTable.bindC2COut(intToAddress(tbe.storSlot), key);
    tbe.isRead := isReadRequest(in_msg.type);
    tbe.isWrite := isWriteRequest(in_msg.type);
    tbe.isDataless := isDatalessRequest(in_msg.type);
    tbe.isAtomic := isAtomicRequest(in_msg.type);
    if (needsRequesterCompAck(in_msg.type)) {
      tbe.pendingCompAcks := 1;
    }
    if (in_msg.type == CHIRequestType:ReadShared) {
      tbe.readFanoutDests.clear();
      tbe.readFanoutDests.add(in_msg.requestor);
    }
  }
}

action(attachMergedReadFromReq, "amr",
       desc="Attach a compatible local ReadShared to an active read") {
  assert(is_valid(tbe));
  peek(reqInPort, CHIRequestMsg) {
    assert(canMergeLocalRead(tbe, in_msg.type, in_msg.requestor));
    tbe.readFanoutDests.add(in_msg.requestor);
    tbe.pendingCompAcks := tbe.pendingCompAcks + 1;
    readMergeAttachCount := readMergeAttachCount + 1;
    readMergeTable.addSharers(address, tbe.readFanoutDests);
    DPRINTF(RubySlicc,
            "C2C merge ReadShared addr=%#x requestor=%s fanout=%d pendingAcks=%d\n",
            address, in_msg.requestor, tbe.readFanoutDests.count(),
            tbe.pendingCompAcks);
  }
}

action(recordRemoteIDs_fromC2CReq, "rrid", desc="Record remote IDs from C2C req") {
  assert(is_valid(tbe));
  peek(c2cRxReqInPort, CHIRequestMsg) {
    Addr key := tbeKey(tbe);
    tbe.reqType := in_msg.type;
    tbe.remoteSrcID := in_msg.origSrcID;
    tbe.remoteTxnID := in_msg.txnId;
    tbe.localSrcID := machineID;
    assignTxnID(tbe);
    txnKeyTable.bindC2CIn(tbe.remoteTxnID, key);
    txnKeyTable.bindLocal(mapAddressToDownstreamMachine(address), tbe.txnID,
                          key);
    txnKeyTable.bindLocalTxn(tbe.txnID, key);
    tbe.peerC2CG := in_msg.c2cSrcGateway;
    tbe.isRead := isReadRequest(in_msg.type);
    tbe.isWrite := isWriteRequest(in_msg.type);
    tbe.isDataless := isDatalessRequest(in_msg.type);
    tbe.isAtomic := isAtomicRequest(in_msg.type);
    if (needsRequesterCompAck(in_msg.type)) {
      tbe.pendingCompAcks := 1;
    }
  }
}

action(recordSnpIDs_fromSnp, "rsnpid", desc="Record snoop IDs from local HN") {
  assert(is_valid(tbe));
  peek(snpInPort, CHIRequestMsg) {
    tbe.reqType := in_msg.type;
    tbe.localSrcID := in_msg.requestor;
    tbe.isSnoop := true;
  }
}

action(recordInboundSnpIDs, "ribsnp",
       desc="Record inbound snoop IDs from C2C") {
  assert(is_valid(tbe));
  peek(c2cRxSnpInPort, CHIRequestMsg) {
    tbe.reqType := in_msg.type;
    tbe.peerC2CG := in_msg.c2cSrcGateway;
    tbe.isSnoop := true;
  }
}

action(recordOutboundSnpTargets, "rosnp",
       desc="Record expected responses for outbound snoop") {
  assert(is_valid(tbe));
  peek(snpInPort, CHIRequestMsg) {
    if (in_msg.hasRmtDest) {
      NetDest peerTargets := in_msg.rmtDest.AND(allPeerUpstreamDest());
      if (peerTargets.count() > 0) {
        tbe.pendingSnpResps := peerTargets.count();
      } else {
        tbe.pendingSnpResps := in_msg.rmtDest.count();
      }
    } else {
      tbe.pendingSnpResps := in_msg.Destination.count();
    }
    assert(tbe.pendingSnpResps > 0);
  }
}

action(recordInboundSnpTargets, "risnp",
       desc="Record expected responses for inbound snoop") {
  assert(is_valid(tbe));
  peek(c2cRxSnpInPort, CHIRequestMsg) {
    tbe.c2cSnpForwardDests.clear();
    if (in_msg.hasRmtDest) {
      NetDest localTargets := in_msg.rmtDest.AND(allUpstreamDest());
      tbe.c2cSnpResponsesToForward := localTargets.count();
      tbe.c2cSnpForwardDests := localTargets;
      localTargets := readMergeTable.expandSharers(address, localTargets);
      tbe.pendingSnpResps := localTargets.count();
    } else {
      tbe.pendingSnpResps := in_msg.Destination.count();
      tbe.c2cSnpResponsesToForward := tbe.pendingSnpResps;
      tbe.c2cSnpForwardDests := in_msg.Destination;
    }
    assert(tbe.pendingSnpResps > 0);
    assert(tbe.c2cSnpResponsesToForward > 0);
    assert(tbe.c2cSnpForwardDests.count() > 0);
  }
}

action(recordSnpRespNoData, "rsnpr",
       desc="Consume one outstanding snoop response without data") {
  assert(is_valid(tbe));
  assert(tbe.pendingSnpResps > 0);
  tbe.pendingSnpResps := tbe.pendingSnpResps - 1;
}

action(recordSnpRespDataFromC2C, "rsnpdc2c",
       desc="Aggregate snoop response data from C2C") {
  assert(is_valid(tbe));
  peek(c2cRxDatInPort, CHIDataMsg) {
    if (tbe.dataBlkValid.isEmpty()) {
      assert(tbe.pendingSnpResps > 0);
      tbe.pendingSnpResps := tbe.pendingSnpResps - 1;
    }
    assert(tbe.dataBlkValid.isOverlap(in_msg.bitMask) == false);
    tbe.dataBlk.copyPartial(in_msg.dataBlk, in_msg.bitMask);
    tbe.dataBlkValid.orMask(in_msg.bitMask);
  }
}

action(recordSnpRespDataFromLocal, "rsnpdloc",
       desc="Aggregate snoop response data from local NoC") {
  assert(is_valid(tbe));
  peek(datInPort, CHIDataMsg) {
    if (tbe.snpDataRespondersSeen.isElement(in_msg.responder) == false) {
      assert(tbe.pendingSnpResps > 0);
      tbe.pendingSnpResps := tbe.pendingSnpResps - 1;
      tbe.snpDataRespondersSeen.add(in_msg.responder);
    }
    if ((tbe.c2cSnpForwardDests.count() == 0) ||
        tbe.c2cSnpForwardDests.isElement(in_msg.responder)) {
      assert(tbe.dataBlkValid.isOverlap(in_msg.bitMask) == false);
      tbe.dataBlk.copyPartial(in_msg.dataBlk, in_msg.bitMask);
      tbe.dataBlkValid.orMask(in_msg.bitMask);
    }
  }
}

////////////////////////////////////////////////////////////////////////////
// Outbound forwarding to C2C link
////////////////////////////////////////////////////////////////////////////

action(forwardReqToC2CTx, "fwdReqC2C", desc="Forward request to C2C TX REQ") {
  assert(is_valid(tbe));
  outboundReqCount := outboundReqCount + 1;
  peek(reqRdyInPort, CHIRequestMsg) {
    enqueue(c2cTxReqOutPort, CHIRequestMsg, request_latency) {
      out_msg := in_msg;
      out_msg.requestor := machineID;
      out_msg.txnId := intToAddress(tbe.storSlot);
      out_msg.usesTxnId := true;
      out_msg.isC2C := true;
      // Keep the stable remote cache identity in origSrcID; fwdRequestor
      // still carries the inner target for data forwarding within the node.
      out_msg.origSrcID := in_msg.requestor;
      out_msg.origTxnId := tbe.localTxnID;
      out_msg.c2cSrcGateway := machineID;
      out_msg.allowRetry := false;  // no retry across C2C
      out_msg.Destination.clear();
      out_msg.Destination.add(machineID);  // bridge handles delivery
    }
  }
}

action(forwardRspToC2CTx, "fwdRspC2C", desc="Forward response to C2C TX RSP") {
  assert(is_valid(tbe));
  peek(rspInPort, CHIResponseMsg) {
    enqueue(c2cTxRspOutPort, CHIResponseMsg, response_latency) {
      out_msg := in_msg;
      out_msg.responder := machineID;
      out_msg.txnId := intToAddress(tbe.storSlot);
      out_msg.usesTxnId := true;
      out_msg.isC2C := true;
      out_msg.c2cSrcGateway := machineID;
      out_msg.Destination.clear();
      out_msg.Destination.add(machineID);  // bridge handles delivery
    }
  }
}

action(forwardFirstCompAckToC2CTx, "fwd1CAckC2C",
       desc="Forward only the leader CompAck for a merged read") {
  assert(is_valid(tbe));
  if (tbe.compAckDone == false) {
    creditMgr.consumeRspCredit();
    peek(rspInPort, CHIResponseMsg) {
      enqueue(c2cTxRspOutPort, CHIResponseMsg, response_latency) {
        out_msg := in_msg;
        out_msg.responder := machineID;
        out_msg.txnId := intToAddress(tbe.storSlot);
        out_msg.usesTxnId := true;
        out_msg.isC2C := true;
        out_msg.c2cSrcGateway := machineID;
        out_msg.Destination.clear();
        out_msg.Destination.add(machineID);
      }
    }
  }
}

action(forwardDatToC2CTx, "fwdDatC2C", desc="Forward data to C2C TX DAT") {
  assert(is_valid(tbe));
  peek(datInPort, CHIDataMsg) {
    enqueue(c2cTxDatOutPort, CHIDataMsg, data_latency) {
      out_msg := in_msg;
      out_msg.responder := machineID;
      out_msg.txnId := intToAddress(tbe.storSlot);
      out_msg.usesTxnId := true;
      out_msg.isC2C := true;
      out_msg.c2cSrcGateway := machineID;
      out_msg.Destination.clear();
      out_msg.Destination.add(machineID);  // bridge handles delivery
    }
  }
}

action(forwardSnpToC2CTx, "fwdSnpC2C", desc="Forward snoop to C2C TX SNP") {
  assert(is_valid(tbe));
  snpForwardCount := snpForwardCount + 1;
  peek(snpInPort, CHIRequestMsg) {
    enqueue(c2cTxSnpOutPort, CHIRequestMsg, snoop_latency) {
      out_msg := in_msg;
      out_msg.isC2C := true;
      out_msg.c2cSrcGateway := machineID;
      out_msg.Destination.clear();
      out_msg.Destination.add(machineID);  // bridge handles delivery
    }
  }
}

// Forward snoop response from C2C RSP to local NoC RSP
// (Used when snoop response arrives on rspIn from C2C peer)
action(forwardC2CSnpRspToLocal, "fwdC2CSnpRspL",
       desc="Forward C2C snoop resp to local HN") {
  assert(is_valid(tbe));
  rsp_onchip := rsp_onchip + 1;
  peek(c2cRxRspInPort, CHIResponseMsg) {
    enqueue(rspOutPort, CHIResponseMsg, response_latency) {
      out_msg := in_msg;
      out_msg.isC2C := false;
      out_msg.Destination.clear();
      out_msg.Destination.add(tbe.localSrcID);
    }
  }
}

// Forward snoop response data from C2C DAT to local NoC DAT
action(forwardC2CSnpDatToLocal, "fwdC2CSnpDatL",
       desc="Forward C2C snoop resp data to local HN") {
  assert(is_valid(tbe));
  dat_onchip := dat_onchip + 1;
  peek(c2cRxDatInPort, CHIDataMsg) {
    enqueue(datOutPort, CHIDataMsg, data_latency) {
      out_msg := in_msg;
      out_msg.isC2C := false;
      out_msg.Destination.clear();
      out_msg.Destination.add(tbe.localSrcID);
    }
  }
}

////////////////////////////////////////////////////////////////////////////
// Inbound forwarding from C2C to local NoC
////////////////////////////////////////////////////////////////////////////

action(forwardC2CReqToLocal, "fwdC2CReqL", desc="Forward C2C request to local NoC") {
  assert(is_valid(tbe));
  inboundReqCount := inboundReqCount + 1;
  req_onchip := req_onchip + 1;
  peek(c2cRxReqInPort, CHIRequestMsg) {
    enqueue(reqOutPort, CHIRequestMsg, request_latency) {
      out_msg := in_msg;
      out_msg.requestor := machineID;  // rewrite SrcID to this C2CG
      out_msg.txnId := tbe.txnID;
      out_msg.usesTxnId := false;  // HNF expects false for non-DVM
      out_msg.isC2C := false;  // clear C2C flag for local NoC
      out_msg.allowRetry := true;
      // Tell HN the actual remote requestor behind this C2CG so
      // it can record the mapping in its directory for targeted snoops.
      out_msg.hasRmtDest := true;
      out_msg.rmtDest.clear();
      out_msg.rmtDest.add(in_msg.origSrcID);
      out_msg.Destination.clear();
      out_msg.Destination.add(mapAddressToDownstreamMachine(address));
    }
  }
}

action(forwardC2CRspToLocal, "fwdC2CRspL", desc="Forward C2C response to local NoC") {
  assert(is_valid(tbe));
  rsp_onchip := rsp_onchip + 1;
  peek(c2cRxRspInPort, CHIResponseMsg) {
    enqueue(rspOutPort, CHIResponseMsg, response_latency) {
      out_msg := in_msg;
      out_msg.responder := machineID;
      out_msg.txnId := tbe.localTxnID;
      out_msg.usesTxnId := false;  // non-DVM: local requester uses addr
      out_msg.isC2C := false;
      out_msg.Destination := localResponseDest(tbe);
    }
  }
}

action(forwardC2CDatToLocal, "fwdC2CDatL", desc="Forward C2C data to local NoC") {
  assert(is_valid(tbe));
  dat_onchip := dat_onchip + 1;
  peek(c2cRxDatInPort, CHIDataMsg) {
    enqueue(datOutPort, CHIDataMsg, data_latency) {
      out_msg := in_msg;
      out_msg.responder := machineID;
      out_msg.txnId := tbe.localTxnID;
      out_msg.usesTxnId := false;  // non-DVM: local requester uses addr
      out_msg.isC2C := false;
      out_msg.Destination := localResponseDest(tbe);
    }
  }
}

action(forwardC2CWrDatToLocal, "fwdC2CWrDatL",
       desc="Forward inbound C2C write data to local HN") {
  assert(is_valid(tbe));
  dat_onchip := dat_onchip + 1;
  peek(c2cRxDatInPort, CHIDataMsg) {
    enqueue(datOutPort, CHIDataMsg, data_latency) {
      out_msg := in_msg;
      out_msg.responder := tbe.remoteSrcID;
      out_msg.txnId := tbe.txnID;
      out_msg.usesTxnId := false;
      out_msg.isC2C := false;
      out_msg.Destination.clear();
      out_msg.Destination.add(
          mapAddressToDownstreamMachine(tbe.addr));
    }
  }
}

action(forwardLocalRspToC2C, "fwdLRspC2C", desc="Forward local response to C2C") {
  assert(is_valid(tbe));
  peek(rspInPort, CHIResponseMsg) {
    enqueue(c2cTxRspOutPort, CHIResponseMsg, response_latency) {
      out_msg := in_msg;
      out_msg.responder := machineID;
      out_msg.txnId := tbe.remoteTxnID;
      out_msg.usesTxnId := true;
      out_msg.isC2C := true;
      out_msg.c2cSrcGateway := machineID;
      out_msg.Destination.clear();
      out_msg.Destination.add(machineID);  // bridge handles delivery
    }
  }
}

action(sendCompToC2C, "sndCompC2C",
  desc="Send only Comp semantics to peer C2C gateway for WritePush completion") {
  assert(is_valid(tbe));
  peek(rspInPort, CHIResponseMsg) {
    enqueue(c2cTxRspOutPort, CHIResponseMsg, response_latency) {
      out_msg := in_msg;
      out_msg.type := CHIResponseType:Comp;
      out_msg.responder := machineID;
      out_msg.txnId := tbe.remoteTxnID;
      out_msg.usesTxnId := true;
      out_msg.isC2C := true;
      out_msg.c2cSrcGateway := machineID;
      out_msg.Destination.clear();
      out_msg.Destination.add(machineID);  // bridge handles delivery
    }
  }
}

action(forwardLocalDatToC2C, "fwdLDatC2C", desc="Forward local data to C2C") {
  assert(is_valid(tbe));
  peek(datInPort, CHIDataMsg) {
    enqueue(c2cTxDatOutPort, CHIDataMsg, data_latency) {
      out_msg := in_msg;
      out_msg.responder := machineID;
      out_msg.txnId := tbe.remoteTxnID;
      out_msg.usesTxnId := true;
      out_msg.isC2C := true;
      out_msg.c2cSrcGateway := machineID;
      out_msg.Destination.clear();
      out_msg.Destination.add(machineID);  // bridge handles delivery
    }
  }
}

// Forward CompAck from remote peer to local HN (inbound flow)
action(forwardCompAckToHN, "fwdCAHN",
       desc="Forward CompAck from C2C to local HN") {
  assert(is_valid(tbe));
  peek(c2cRxRspInPort, CHIResponseMsg) {
    enqueue(rspOutPort, CHIResponseMsg, response_latency) {
      out_msg := in_msg;
      out_msg.responder := machineID;
      out_msg.txnId := tbe.txnID;
      out_msg.usesTxnId := false;
      out_msg.isC2C := false;
      out_msg.Destination.clear();
      out_msg.Destination.add(
          mapAddressToDownstreamMachine(tbe.addr));
    }
  }
}

// Forward local snoop response (no data) to peer C2CG via C2C
action(forwardLocalSnpRspToC2C, "fwdLSnpRspC2C",
       desc="Forward local snoop resp to C2C") {
  assert(is_valid(tbe));
  peek(rspInPort, CHIResponseMsg) {
    if (tbe.c2cSnpForwardDests.isElement(in_msg.responder)) {
      enqueue(c2cTxRspOutPort, CHIResponseMsg, response_latency) {
        out_msg := in_msg;
        out_msg.isC2C := true;
        out_msg.c2cSrcGateway := machineID;
        out_msg.Destination.clear();
        out_msg.Destination.add(machineID);
      }
    }
  }
}

// Forward local snoop response data to peer C2CG via C2C
action(forwardLocalSnpDatToC2C, "fwdLSnpDatC2C",
       desc="Forward local snoop resp data to C2C") {
  assert(is_valid(tbe));
  peek(datInPort, CHIDataMsg) {
    if (tbe.c2cSnpForwardDests.isElement(in_msg.responder)) {
      enqueue(c2cTxDatOutPort, CHIDataMsg, data_latency) {
        out_msg := in_msg;
        out_msg.isC2C := true;
        out_msg.c2cSrcGateway := machineID;
        out_msg.Destination.clear();
        out_msg.Destination.add(machineID);
      }
    }
  }
}

// Forward C2C snoop to local NoC — rewrite requestor so responses
// come back to this C2CG (not the remote HN).
action(forwardC2CSnpToLocal, "fwdC2CSnpL", desc="Forward C2C snoop to local") {
  assert(is_valid(tbe));
  snp_onchip := snp_onchip + 1;
  peek(c2cRxSnpInPort, CHIRequestMsg) {
    NetDest localTargets := in_msg.rmtDest.AND(allUpstreamDest());
    localTargets := readMergeTable.expandSharers(address, localTargets);
    enqueue(snpOutPort, CHIRequestMsg, snoop_latency) {
      out_msg := in_msg;
      out_msg.isC2C := false;
      out_msg.requestor := machineID;
      // Use rmtDest from HN to target the specific remote caches
      out_msg.Destination.clear();
      assert(in_msg.hasRmtDest);
      assert(localTargets.count() > 0);
      out_msg.Destination.addNetDest(localTargets);
    }
  }
}


////////////////////////////////////////////////////////////////////////////
// Retry handling
////////////////////////////////////////////////////////////////////////////

action(sendRetryAck, desc="Send RetryAck to requester") {
  peek(retryTriggerInPort, RetryTriggerMsg) {
    enqueue(rspOutPort, CHIResponseMsg, response_latency) {
      out_msg.addr := in_msg.addr;
      out_msg.type := CHIResponseType:RetryAck;
      out_msg.responder := machineID;
      out_msg.Destination.add(in_msg.retryDest);
    }
  }
}

action(sendPCrdGrant, desc="Send PCrdGrant to retrying requester") {
  peek(retryTriggerInPort, RetryTriggerMsg) {
    enqueue(rspOutPort, CHIResponseMsg, response_latency) {
      out_msg.addr := in_msg.addr;
      out_msg.type := CHIResponseType:PCrdGrant;
      out_msg.responder := machineID;
      out_msg.Destination.add(in_msg.retryDest);
    }
  }
}

action(recordPCrdType, "rpct", desc="Record PCrdType from RetryAck") {
  assert(is_valid(tbe));
  tbe.retryPending := true;
  retryAbsorbCount := retryAbsorbCount + 1;
}

action(recordPCrdGrant, "rpcg",
       desc="Record PCrdGrant until RetryAck arrives") {
  assert(is_valid(tbe));
  tbe.retryGrantPending := true;
}

action(saveRetryState, "srst",
  desc="Remember current state as retry resume state") {
  assert(is_valid(tbe));
  tbe.retryState := tbe.state;
}

action(resumeRetryState, "rrst",
       desc="Restore retry resume state before reissue") {
  assert(is_valid(tbe));
  assert(tbe.retryState != State:I);
  setState(tbe, address, tbe.retryState);
}

action(reissueRequest, "reis", desc="Re-issue request after PCrdGrant") {
  assert(is_valid(tbe));
  tbe.retryPending := false;
  tbe.retryGrantPending := false;
  tbe.retryState := State:I;
  enqueue(reqOutPort, CHIRequestMsg, request_latency) {
    out_msg.addr := tbe.addr;
    out_msg.type := tbe.reqType;
    out_msg.requestor := machineID;
    out_msg.fwdRequestor := tbe.localSrcID;
    if (tbe.isOutbound == false) {
      out_msg.fwdRequestor := tbe.remoteSrcID;
    } else if (machineIDToMachineType(tbe.localFwdRequestor) == MachineType:Cache) {
      out_msg.fwdRequestor := tbe.localFwdRequestor;
    }
    out_msg.txnId := tbe.txnID;
    out_msg.usesTxnId := false;  // HNF expects false for non-DVM
    out_msg.allowRetry := false;  // already have credit
    out_msg.hasRmtDest := true;
    out_msg.rmtDest.clear();
    out_msg.rmtDest.add(tbe.localSrcID);
    if (tbe.isOutbound == false) {
      out_msg.rmtDest.clear();
      out_msg.rmtDest.add(tbe.remoteSrcID);
    } else if (machineIDToMachineType(tbe.localFwdRequestor) == MachineType:Cache) {
      out_msg.rmtDest.clear();
      out_msg.rmtDest.add(tbe.localFwdRequestor);
    }
    out_msg.Destination.clear();
    out_msg.Destination.add(mapAddressToDownstreamMachine(tbe.addr));
  }
}

////////////////////////////////////////////////////////////////////////////
// Expectation tracking
////////////////////////////////////////////////////////////////////////////

action(setExpectingData, "seD", desc="Mark TBE as expecting data") {
  assert(is_valid(tbe));
  tbe.expectingData := true;
}

action(clearExpectingData, "ceD", desc="Clear expecting data flag") {
  assert(is_valid(tbe));
  tbe.expectingData := false;
}

action(setExpectingComp, "seC", desc="Mark TBE as expecting response") {
  assert(is_valid(tbe));
  tbe.expectingComp := true;
}

action(clearExpectingComp, "ceC", desc="Clear expecting response flag") {
  assert(is_valid(tbe));
  tbe.expectingComp := false;
}

action(recordWriteComp, "rwc", desc="Record that write Comp has arrived") {
  assert(is_valid(tbe));
  tbe.writeCompReceived := true;
}

action(trackDatFlit, "tdf", desc="Track data flit bytes forwarded") {
  assert(is_valid(tbe));
  tbe.rxtxBytes := tbe.rxtxBytes + data_channel_size;
}

action(markWriteDataForwarded, "mwdf",
       desc="Mark buffered write data as fully forwarded") {
  assert(is_valid(tbe));
  tbe.rxtxBytes := blockSize;
}

action(checkTxnComplete, "ctc",
       desc="If all data + CompAck done, trigger completion") {
  assert(is_valid(tbe));
  if (allDataFlitsForwarded(tbe) && tbe.compAckDone &&
      tbe.pendingCompAcks == 0) {
    enqueue(triggerOutPort, TriggerMsg, 0) {
      out_msg.addr := address;
      out_msg.tbeKey := tbeKey(tbe);
      out_msg.event := Event:CompleteTxn;
    }
  }
}

action(checkDataTxnComplete, "cdtc",
       desc="If all data flits done, trigger completion") {
  assert(is_valid(tbe));
  if (allDataFlitsForwarded(tbe)) {
    enqueue(triggerOutPort, TriggerMsg, 0) {
      out_msg.addr := address;
      out_msg.tbeKey := tbeKey(tbe);
      out_msg.event := Event:CompleteTxn;
    }
  }
}

action(checkWriteBackTxnComplete, "cwbtc",
       desc="Complete WriteBackFull once all data flits are forwarded") {
  assert(is_valid(tbe));
  if ((tbe.reqType == CHIRequestType:WriteBackFull) &&
      allDataFlitsForwarded(tbe)) {
    enqueue(triggerOutPort, TriggerMsg, 0) {
      out_msg.addr := address;
      out_msg.tbeKey := tbeKey(tbe);
      out_msg.event := Event:CompleteTxn;
    }
  }
}

action(checkWriteTxnComplete, "cwtc",
       desc="Complete write when required data and Comp have both arrived") {
  assert(is_valid(tbe));
  if (allDataFlitsForwarded(tbe) &&
      (tbe.writeCompReceived || !writeCompRequired(tbe.reqType))) {
    enqueue(triggerOutPort, TriggerMsg, 0) {
      out_msg.addr := address;
      out_msg.tbeKey := tbeKey(tbe);
      out_msg.event := Event:CompleteTxn;
    }
  }
}

action(markCompAckDone, "mcad",
       desc="Record that CompAck has been forwarded") {
  assert(is_valid(tbe));
  if (tbe.pendingCompAcks > 0) {
    tbe.pendingCompAcks := tbe.pendingCompAcks - 1;
  }
  tbe.compAckDone := true;
}

action(markNoDataExpected, "mnde",
       desc="Set rxtxBytes to blockSize for dataless flows") {
  assert(is_valid(tbe));
  tbe.rxtxBytes := blockSize;
}

////////////////////////////////////////////////////////////////////////////
// Queue pop actions
////////////////////////////////////////////////////////////////////////////

action(popReqRdyQueue, "prq", desc="Pop reqRdy queue") {
  reqRdyInPort.dequeue(clockEdge());
}

action(popReqInQueue, "preq", desc="Pop reqIn queue") {
  reqInPort.dequeue(clockEdge());
}

action(popRspInQueue, "prsp", desc="Pop rspIn queue") {
  rspInPort.dequeue(clockEdge());
}

action(popDatInQueue, "pdat", desc="Pop datIn queue") {
  datInPort.dequeue(clockEdge());
}

action(popSnpInQueue, "psnp", desc="Pop snpIn queue") {
  snpInPort.dequeue(clockEdge());
}

action(popC2CRxReqQueue, "pc2crq", desc="Pop C2C RX REQ queue") {
  c2cRxReqInPort.dequeue(clockEdge());
}

action(popC2CRxSnpQueue, "pc2csnp", desc="Pop C2C RX SNP queue") {
  c2cRxSnpInPort.dequeue(clockEdge());
}

action(popC2CRxRspQueue, "pc2crsp", desc="Pop C2C RX RSP queue") {
  c2cRxRspInPort.dequeue(clockEdge());
}

action(popC2CRxDatQueue, "pc2cdat", desc="Pop C2C RX DAT queue") {
  c2cRxDatInPort.dequeue(clockEdge());
}

action(popRetryTriggerQueue, "prtq", desc="Pop retry trigger queue") {
  retryTriggerInPort.dequeue(clockEdge());
}

action(popTriggerQueue, "ptq", desc="Pop trigger queue") {
  triggerInPort.dequeue(clockEdge());
}

action(stallRequestQueue, "str", desc="Stall request queue") {
  peek(reqRdyInPort, CHIRequestMsg) {
    stall_and_wait(reqRdyInPort, address);
  }
}

action(stallC2CRxReqQueue, "stc2crq", desc="Stall C2C RX request queue") {
  peek(c2cRxReqInPort, CHIRequestMsg) {
    stall_and_wait(c2cRxReqInPort, address);
  }
}

action(stallSnpQueue, "stsnp", desc="Stall snoop queue") {
  peek(snpInPort, CHIRequestMsg) {
    stall_and_wait(snpInPort, address);
  }
}

action(wakeUpStalled, "wa", desc="Wake up stalled requests") {
  wakeUpAllBuffers(address);
}

////////////////////////////////////////////////////////////////////////////
// DVM actions (Phase 4: DN-C2C role)
////////////////////////////////////////////////////////////////////////////

action(allocateDvmTBE, "advmtbe", desc="Allocate DVM TBE") {
  storDvmTBEs.decrementReserved();
  dvmTBEs.allocate(address);
  set_tbe(dvmTBEs[address]);
  tbe.storSlot := storDvmTBEs.addEntryToNewSlot();
  tbe.addr := address;
  tbe.allocTime := curTick();
  clearTBEDefaults(tbe);
  tbe.isDVM := true;
  tbe.isOutbound := true;  // DVM originates locally, always outbound
}

action(recordDvmP1, "rdvmp1",
       desc="Buffer DVM P1 info in TBE from snpIn") {
  assert(is_valid(tbe));
  peek(snpInPort, CHIRequestMsg) {
    tbe.reqType := in_msg.type;
    tbe.localSrcID := in_msg.requestor;  // the MN
    tbe.localTxnID := in_msg.addr;       // MN's txnId (= addr field)
  }
}

action(sendDvmReqToC2C, "sdvmreq",
       desc="Reconstruct DvmOp and send to C2C REQ") {
  assert(is_valid(tbe));
  dvmReqsSent := dvmReqsSent + 1;
  Addr remoteDvmAddr := intToAddress(
      addressToInt(tbe.localTxnID) + dvm_txnid_offset);
  tbe.remoteTxnID := remoteDvmAddr;
  CHIRequestType dvmType := CHIRequestType:DvmOpNonSync;
  if (isDvmSyncType(tbe.reqType)) {
    dvmType := CHIRequestType:DvmOpSync;
  }
  enqueue(c2cTxReqOutPort, CHIRequestMsg, request_latency) {
    out_msg.addr := remoteDvmAddr;
    out_msg.accAddr := remoteDvmAddr;
    out_msg.accSize := blockSize;
    out_msg.type := dvmType;
    out_msg.requestor := machineID;
    out_msg.txnId := remoteDvmAddr;
    out_msg.usesTxnId := true;
    out_msg.isC2C := true;
    out_msg.origSrcID := machineID;
    out_msg.origTxnId := tbe.localTxnID;
    out_msg.c2cSrcGateway := machineID;
    out_msg.allowRetry := false;
    out_msg.Destination.clear();
    out_msg.Destination.add(machineID);  // bridge handles delivery
  }
}

action(sendDvmDataToC2C, "sdvmdat",
       desc="Send NCBWrData for DVM across C2C DAT") {
  assert(is_valid(tbe));
  enqueue(c2cTxDatOutPort, CHIDataMsg, data_latency) {
    out_msg.addr := tbe.remoteTxnID;
    out_msg.type := CHIDataType:NCBWrData;
    out_msg.responder := machineID;
    out_msg.txnId := tbe.remoteTxnID;
    out_msg.usesTxnId := true;
    out_msg.isC2C := true;
    out_msg.c2cSrcGateway := machineID;
    out_msg.dataBlk := tbe.dataBlk;  // MN ignores data contents
    out_msg.Destination.clear();
    out_msg.Destination.add(machineID);  // bridge handles delivery
  }
}

action(recordDvmPeerFromRsp, "rdvmpeer",
       desc="Record peer C2CG from C2C RX response") {
  assert(is_valid(tbe));
  peek(c2cRxRspInPort, CHIResponseMsg) {
    tbe.peerC2CG := in_msg.c2cSrcGateway;
  }
}

action(sendSnpRespIToMN, "ssnprsp",
       desc="Send SnpResp_I to local MN") {
  assert(is_valid(tbe));
  enqueue(rspOutPort, CHIResponseMsg, response_latency) {
    out_msg.addr := tbe.localTxnID;
    out_msg.type := CHIResponseType:SnpResp_I;
    out_msg.responder := machineID;
    out_msg.txnId := tbe.localTxnID;
    out_msg.usesTxnId := true;
    out_msg.Destination.clear();
    out_msg.Destination.add(tbe.localSrcID);  // the MN
  }
}

action(deallocateDvmTBE, "ddvmtbe", desc="Deallocate DVM TBE") {
  assert(is_valid(tbe));
  DPRINTF(RubySlicc, "C2C dvmTBE dealloc addr=%#x lifetime=%llu ticks\n",
          address, curTick() - tbe.allocTime);
  storDvmTBEs.removeEntryFromSlot(tbe.storSlot);
  dvmTBEs.deallocate(address);
  unset_tbe();
  // No retry-queue handling: DVM TBEs are separate from main pool
}

////////////////////////////////////////////////////////////////////////////
// WritePush actions (Phase 6: IHI0098A B4.6)
////////////////////////////////////////////////////////////////////////////

// Source-side: combine buffered request + arriving WriteData into
// WrReqDataS (<=32B) or WrReqDataL (<=64B) and send across C2C DAT.
action(combineAndSendWritePush, "cwp",
       desc="Combine req+data into WrReqData and send to C2C") {
  assert(is_valid(tbe));
  writePushCount := writePushCount + 1;
  peek(datInPort, CHIDataMsg) {
    // IHI0098A B4.6: Short <=32B, Long <=64B
    CHIDataType wpType := CHIDataType:WrReqDataL;
    if (data_channel_size <= 32) {
      wpType := CHIDataType:WrReqDataS;
    }
    enqueue(c2cTxDatOutPort, CHIDataMsg, data_latency) {
      out_msg.addr := address;
      out_msg.type := wpType;
      out_msg.responder := tbe.localSrcID;
      out_msg.dataBlk := in_msg.dataBlk;
      out_msg.bitMask := in_msg.bitMask;
      out_msg.txnId := intToAddress(tbe.storSlot);
      out_msg.usesTxnId := true;
      out_msg.isC2C := true;
      out_msg.c2cSrcGateway := machineID;
      out_msg.wrReqType := tbe.reqType;
      out_msg.Destination.clear();
      out_msg.Destination.add(machineID);  // bridge handles delivery
    }
  }
}

// Receiver-side: split incoming WrReqData into a write request
// forwarded to the local HN via reqOut.
action(splitWrReqDataToReq, "swrr",
       desc="Split WrReqData: forward write request to local HN") {
  assert(is_valid(tbe));
  inboundReqCount := inboundReqCount + 1;
  peek(c2cRxDatInPort, CHIDataMsg) {
    tbe.reqType := in_msg.wrReqType;
    tbe.remoteSrcID := in_msg.responder;
    tbe.remoteTxnID := in_msg.txnId;
    tbe.peerC2CG := in_msg.c2cSrcGateway;
    tbe.localSrcID := machineID;
    assignTxnID(tbe);
    txnKeyTable.bindC2CIn(tbe.remoteTxnID, tbeKey(tbe));
    txnKeyTable.bindLocal(mapAddressToDownstreamMachine(address), tbe.txnID,
          tbeKey(tbe));
    txnKeyTable.bindLocalTxn(tbe.txnID, tbeKey(tbe));
    tbe.isWrite := true;
    // Buffer the data for later forwarding after DBID
    tbe.dataBlk := in_msg.dataBlk;
    tbe.dataBlkValid := in_msg.bitMask;
    enqueue(reqOutPort, CHIRequestMsg, request_latency) {
      out_msg.addr := in_msg.addr;
      out_msg.accAddr := in_msg.addr;
      out_msg.accSize := blockSize;
      out_msg.type := in_msg.wrReqType;
      out_msg.requestor := machineID;
      out_msg.txnId := tbe.txnID;
      out_msg.usesTxnId := false;  // HNF expects false for non-DVM
      out_msg.isC2C := false;
      out_msg.allowRetry := true;
      out_msg.hasRmtDest := true;
      out_msg.rmtDest.clear();
      out_msg.rmtDest.add(in_msg.responder);
      out_msg.Destination.clear();
      out_msg.Destination.add(
          mapAddressToDownstreamMachine(in_msg.addr));
    }
  }
}

// Receiver-side: after DBID from local HN, send buffered data as
// CBWrData to the local HN.
action(sendBufferedWriteData, "sbwd",
       desc="Send TBE-buffered write data to local HN") {
  assert(is_valid(tbe));
  enqueue(datOutPort, CHIDataMsg, data_latency) {
    out_msg.addr := tbe.addr;
    out_msg.type := CHIDataType:CBWrData_I;
    out_msg.responder := machineID;
    out_msg.dataBlk := tbe.dataBlk;
    out_msg.bitMask := tbe.dataBlkValid;
    out_msg.txnId := tbe.txnID;
    out_msg.usesTxnId := false;  // HNF expects false for non-DVM
    out_msg.isC2C := false;
    out_msg.Destination.clear();
    out_msg.Destination.add(
        mapAddressToDownstreamMachine(tbe.addr));
  }
}
