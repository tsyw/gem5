// CHI C2C Gateway port definitions

////////////////////////////////////////////////////////////////////////////
// Outbound port definitions
////////////////////////////////////////////////////////////////////////////

// NoC-side outbound ports
out_port(reqOutPort, CHIRequestMsg, reqOut);
out_port(snpOutPort, CHIRequestMsg, snpOut);
out_port(rspOutPort, CHIResponseMsg, rspOut);
out_port(datOutPort, CHIDataMsg, datOut);

// C2C-side outbound ports
out_port(c2cTxReqOutPort, CHIRequestMsg, c2cTxReq);
out_port(c2cTxSnpOutPort, CHIRequestMsg, c2cTxSnp);
out_port(c2cTxRspOutPort, CHIResponseMsg, c2cTxRsp);
out_port(c2cTxDatOutPort, CHIDataMsg, c2cTxDat);

// Internal trigger ports
out_port(triggerOutPort, TriggerMsg, triggerQueue);
out_port(retryTriggerOutPort, RetryTriggerMsg, retryTriggerQueue);
out_port(reqRdyOutPort, CHIRequestMsg, reqRdy);

// Include helper functions (must come after out_port declarations)
include "CHI-c2c-funcs.sm";

////////////////////////////////////////////////////////////////////////////
// Inbound port definitions (ordered by rank - highest priority first)
////////////////////////////////////////////////////////////////////////////

// Rank 12: C2C RX Response (highest priority)
in_port(c2cRxRspInPort, CHIResponseMsg, c2cRxRsp, rank=12,
        rsc_stall_handler=c2cRxRspInPort_stall) {
  if (c2cRxRspInPort.isReady(clockEdge())) {
    printResources();
    peek(c2cRxRspInPort, CHIResponseMsg) {
      DPRINTF(RubySlicc,
        "c2cRxRspInPort: addr=%#x type=%s responder=%s txnId=%#x usesTxnId=%d gateway=%s\n",
        in_msg.addr, in_msg.type, in_msg.responder,
        in_msg.txnId, in_msg.usesTxnId, in_msg.c2cSrcGateway);
      // Snoop responses: check snpTBEs first (collision avoidance)
      TBE tbe;
      if (isSnpRespType(in_msg.type)) {
        tbe := snpTBEs[in_msg.addr];
        if (is_valid(tbe) == false) {
          tbe := dvmTBEs[in_msg.addr];
        }
        if (is_valid(tbe) == false) {
          tbe := lookupTBEByAddress(in_msg.addr);
        }
        if (is_valid(tbe) == false) {
          error("c2cRxRspInPort: no snoop TBE for response message");
        }
        if ((tbe.pendingSnpResps == 1) &&
            (tbe.dataBlkValid.isEmpty() || tbe.dataBlkValid.isFull())) {
          trigger(Event:RspIn_SnpResp_Out, in_msg.addr, tbe);
        } else {
          trigger(Event:RspIn_SnpResp_More_Out, in_msg.addr, tbe);
        }
      } else {
        if (in_msg.type == CHIResponseType:CompAck) {
          tbe := lookupTBEByC2CInScoped(in_msg.c2cSrcGateway,
                                        in_msg.txnId, in_msg.addr);
        } else {
          tbe := lookupTBEByC2COut(in_msg.txnId);
        }
        if (is_valid(tbe) == false) {
          tbe := dvmTBEs[in_msg.addr];
        }
        if (is_valid(tbe)) {
          DPRINTF(RubySlicc,
                  "c2cRxRspMatch: addr=%#x state=%s outbound=%d storSlot=%d localSrc=%s localTxn=%#x remoteSrc=%s remoteTxn=%#x\n",
                  in_msg.addr, tbe.state, tbe.isOutbound, tbe.storSlot,
                  tbe.localSrcID, tbe.localTxnID,
                  tbe.remoteSrcID, tbe.remoteTxnID);
          if (tbe.isOutbound) {
            // Outbound TBE: response from remote (return C2C credits)
            Event ev := respToEventOut(in_msg.type);
            if ((tbe.state == State:ACTIVE_WAIT_SEP) &&
                (ev == Event:RspIn_RespSepData_Out) &&
                tbe.expectingComp) {
              trigger(Event:RspIn_SepReadResp_Done_Out,
                      in_msg.addr, tbe);
            } else {
              trigger(ev, in_msg.addr, tbe);
            }
          } else {
            // Inbound TBE: CompAck from remote RN (return RSP credit)
            trigger(respToEventIn(in_msg.type), in_msg.addr, tbe);
          }
        } else {
          error("c2cRxRspInPort: no TBE for response message");
        }
      }
    }
  }
}
bool c2cRxRspInPort_stall() {
  error("c2cRxRspInPort must never stall\n");
  return false;
}

// Rank 11: C2C RX Data
in_port(c2cRxDatInPort, CHIDataMsg, c2cRxDat, rank=11,
        rsc_stall_handler=c2cRxDatInPort_stall) {
  if (c2cRxDatInPort.isReady(clockEdge())) {
    printResources();
    peek(c2cRxDatInPort, CHIDataMsg) {
      DPRINTF(RubySlicc,
              "c2cRxDatInPort: addr=%#x type=%s responder=%s txnId=%#x usesTxnId=%d gateway=%s\n",
              in_msg.addr, in_msg.type, in_msg.responder,
              in_msg.txnId, in_msg.usesTxnId, in_msg.c2cSrcGateway);
      // WritePush WrReqData starts a new transaction: needs TBE slot
      if (isWrReqDataType(in_msg.type)) {
        if (storTBEs.areNSlotsAvailable(1)) {
          storTBEs.incrementReserved();
          trigger(Event:DatIn_WrReqData, in_msg.addr, nullTBE());
        } else {
          c2cRxDatInPort.recycle(clockEdge(),
                                  cyclesToTicks(stall_recycle_lat));
        }
      } else if (isSnpRespDataType(in_msg.type)) {
        // Snoop data: non-directional, check snpTBEs first
        TBE tbe := snpTBEs[in_msg.addr];
        if (is_valid(tbe) == false) {
          tbe := lookupTBEByAddress(in_msg.addr);
        }
        if (is_valid(tbe) == false) {
          error("c2cRxDatInPort: no snoop TBE for data message");
        }
        WriteMask combinedMask := tbe.dataBlkValid;
        combinedMask.orMask(in_msg.bitMask);
        bool firstResponderData :=
          tbe.snpDataRespondersSeen.isElement(in_msg.responder) == false;
        int pendingAfter := tbe.pendingSnpResps;
        if ((firstResponderData == true) && (pendingAfter > 0)) {
          pendingAfter := pendingAfter - 1;
        }
        bool finalData := combinedMask.isFull() && (pendingAfter == 0);
        if (finalData) {
          trigger(Event:DatIn_SnpRespData_Out, in_msg.addr, tbe);
        } else {
          trigger(Event:DatIn_SnpRespData_More_Out, in_msg.addr, tbe);
        }
      } else {
        // Regular data from C2C: outbound TBE → read response (_Out),
        // inbound TBE → write/atomic data from remote (_In)
        TBE tbe;
        if (isWriteDataType(in_msg.type)) {
          tbe := lookupTBEByC2CInScoped(in_msg.c2cSrcGateway,
                                        in_msg.txnId, in_msg.addr);
        } else {
          tbe := lookupTBEByC2COut(in_msg.txnId);
        }
        if (is_valid(tbe)) {
          DPRINTF(RubySlicc,
                  "c2cRxDatMatch: addr=%#x state=%s outbound=%d storSlot=%d localSrc=%s localTxn=%#x remoteSrc=%s remoteTxn=%#x\n",
                  in_msg.addr, tbe.state, tbe.isOutbound, tbe.storSlot,
                  tbe.localSrcID, tbe.localTxnID,
                  tbe.remoteSrcID, tbe.remoteTxnID);
          if (tbe.isOutbound) {
            if (isWriteDataType(in_msg.type)) {
              error("c2cRxDatInPort: write data matched outbound TBE");
            } else {
              Event ev := dataToEventOut(in_msg.type);
              if (tbe.state == State:ACTIVE_WAIT_SEP) {
                if (tbe.expectingData &&
                    (ev == Event:DatIn_DataSepResp_Out)) {
                  trigger(Event:DatIn_SepReadData_Done_Out,
                          in_msg.addr, tbe);
                } else if (tbe.expectingComp &&
                           ((ev == Event:DatIn_CompData_Out) ||
                            (ev == Event:DatIn_DataSepResp_Out))) {
                  trigger(Event:DatIn_SepReadData_More_Out,
                          in_msg.addr, tbe);
                } else {
                  trigger(ev, in_msg.addr, tbe);
                }
              } else {
                trigger(ev, in_msg.addr, tbe);
              }
            }
          } else {
            trigger(dataToEventIn(in_msg.type), in_msg.addr, tbe);
          }
        } else {
          error("c2cRxDatInPort: no TBE for data message");
        }
      }
    }
  }
}
bool c2cRxDatInPort_stall() {
  error("c2cRxDatInPort must never stall\n");
  return false;
}

// Rank 10: NoC Response
in_port(rspInPort, CHIResponseMsg, rspIn, rank=10,
        rsc_stall_handler=rspInPort_stall) {
  if (rspInPort.isReady(clockEdge())) {
    printResources();
    peek(rspInPort, CHIResponseMsg) {
      DPRINTF(RubySlicc,
              "rspInPort: addr=%#x type=%s responder=%s txnId=%#x\n",
              in_msg.addr, in_msg.type, in_msg.responder, in_msg.txnId);
      // RetryAck and PCrdGrant are non-directional (always from local HN)
      if ((in_msg.type == CHIResponseType:RetryAck) ||
          (in_msg.type == CHIResponseType:PCrdGrant)) {
        TBE tbe := lookupTBEByLocal(in_msg.responder, in_msg.txnId,
                  in_msg.addr);
        if (is_valid(tbe) && (tbe.isOutbound == false) &&
            (in_msg.txnId == tbe.txnID)) {
          if (in_msg.type == CHIResponseType:RetryAck) {
            if (tbe.retryPending == false && tbe.retryGrantPending) {
              trigger(Event:RetryAckAfterPCrdGrantFromHN, in_msg.addr, tbe);
            } else if (tbe.retryPending == false) {
              trigger(Event:RetryAckFromHN, in_msg.addr, tbe);
            } else {
              DPRINTF(RubySlicc,
                      "rspInPort: absorb duplicate retry/grant addr=%#x type=%s txnId=%#x state=%s tbeTxnID=%#x outbound=%d retryPending=%d retryGrantPending=%d\n",
                      in_msg.addr, in_msg.type, in_msg.txnId,
                      tbe.state, tbe.txnID, tbe.isOutbound,
                      tbe.retryPending, tbe.retryGrantPending);
              rspInPort.dequeue(clockEdge());
            }
          } else if (tbe.retryPending) {
            if (tbe.state == State:RETRY_WAIT) {
              if (tbe.retryState == State:REQ_ACTIVE) {
                trigger(Event:PCrdGrantRetryReqFromHN, in_msg.addr, tbe);
              } else if (tbe.retryState == State:WR_ACTIVE_DBID) {
                trigger(Event:PCrdGrantRetryWriteFromHN, in_msg.addr, tbe);
              } else if (tbe.retryState == State:COMPACK_DL_ACTIVE) {
                trigger(Event:PCrdGrantRetryCompAckDatalessFromHN,
                        in_msg.addr, tbe);
              } else if (tbe.retryState == State:COMP_ONLY_DL_ACTIVE) {
                trigger(Event:PCrdGrantRetryCompOnlyDatalessFromHN,
                        in_msg.addr, tbe);
              } else if ((tbe.retryState == State:ATOMIC_ACTIVE) ||
                         (tbe.retryState == State:ATOMIC_WAIT_DBID)) {
                trigger(Event:PCrdGrantRetryAtomicFromHN, in_msg.addr, tbe);
              } else if (tbe.retryState == State:WR_PUSH_FWD_WAIT_DBID) {
                trigger(Event:PCrdGrantRetryWritePushFromHN,
                        in_msg.addr, tbe);
              } else {
                error("rspInPort: invalid retryState for PCrdGrant");
              }
            } else {
              trigger(Event:PCrdGrantFromHN, in_msg.addr, tbe);
            }
          } else if (tbe.retryGrantPending == false) {
            trigger(Event:EarlyPCrdGrantFromHN, in_msg.addr, tbe);
          } else {
            DPRINTF(RubySlicc,
                    "rspInPort: absorb duplicate retry/grant addr=%#x type=%s txnId=%#x state=%s tbeTxnID=%#x outbound=%d retryPending=%d retryGrantPending=%d\n",
                    in_msg.addr, in_msg.type, in_msg.txnId,
                    tbe.state, tbe.txnID, tbe.isOutbound,
                    tbe.retryPending, tbe.retryGrantPending);
            rspInPort.dequeue(clockEdge());
          }
        } else {
          if (is_valid(tbe)) {
            DPRINTF(RubySlicc,
                    "rspInPort: absorb stale retry/grant addr=%#x type=%s txnId=%#x state=%s tbeTxnID=%#x outbound=%d retryPending=%d retryGrantPending=%d\n",
                    in_msg.addr, in_msg.type, in_msg.txnId,
                    tbe.state, tbe.txnID, tbe.isOutbound,
                    tbe.retryPending, tbe.retryGrantPending);
          } else {
            DPRINTF(RubySlicc,
                    "rspInPort: absorb stale retry/grant addr=%#x type=%s txnId=%#x without active TBE\n",
                    in_msg.addr, in_msg.type, in_msg.txnId);
          }
          rspInPort.dequeue(clockEdge());
        }
      } else if (isSnpRespType(in_msg.type)) {
        // Snoop responses: check snpTBEs first
        TBE tbe := snpTBEs[in_msg.addr];
        if (is_valid(tbe) == false) {
          tbe := lookupTBEByAddress(in_msg.addr);
        }
        if (is_valid(tbe) == false) {
          error("rspInPort: no snoop TBE for response message");
        }
        if (tbe.state != State:SNP_WAIT_RESP) {
          DPRINTF(RubySlicc,
                  "rspInPort: absorb stale snoop response addr=%#x type=%s responder=%s state=%s\n",
                  in_msg.addr, in_msg.type, in_msg.responder, tbe.state);
          rspInPort.dequeue(clockEdge());
        } else if ((tbe.pendingSnpResps == 1) &&
            (tbe.dataBlkValid.isEmpty() || tbe.dataBlkValid.isFull())) {
          trigger(Event:RspIn_SnpResp_In, in_msg.addr, tbe);
        } else {
          trigger(Event:RspIn_SnpResp_More_In, in_msg.addr, tbe);
        }
      } else {
        TBE tbe := lookupTBEByLocal(in_msg.responder, in_msg.txnId,
                                    in_msg.addr);
        if (is_valid(tbe) == false) {
          tbe := lookupTBEByLocalTxn(in_msg.txnId, in_msg.addr);
        }
        if (is_valid(tbe)) {
          if (tbe.isOutbound) {
            // Outbound TBE: CompAck from local RN going to C2C TX
            trigger(respToEventOut(in_msg.type), in_msg.addr, tbe);
          } else {
            // Inbound TBE: Comp/DBIDResp from local HN going to C2C TX
            Event ev := respToEventIn(in_msg.type);
            if ((tbe.state == State:ACTIVE_WAIT_SEP) &&
                (ev == Event:RspIn_RespSepData_In) &&
                tbe.expectingComp) {
              trigger(Event:RspIn_SepReadResp_Done_In,
                      in_msg.addr, tbe);
            } else if (tbe.state == State:RETRY_WAIT) {
              if (ev == Event:RspIn_CompDBIDResp_In) {
                if (in_msg.stale) {
                  trigger(Event:RspIn_StaleRetryCompDBIDResp_In,
                          in_msg.addr, tbe);
                } else {
                  error("rspInPort: non-stale CompDBIDResp in RETRY_WAIT");
                }
              } else if (ev == Event:RspIn_Comp_In) {
                if (tbe.retryState == State:WR_PUSH_FWD_WAIT_DBID) {
                  trigger(Event:RspIn_RetryCompWritePush_In,
                          in_msg.addr, tbe);
                } else if (tbe.isWrite) {
                  trigger(Event:RspIn_RetryCompWrite_In,
                          in_msg.addr, tbe);
                } else if (tbe.isDataless &&
                           needsRequesterCompAck(tbe.reqType)) {
                  trigger(Event:RspIn_RetryCompAckDataless_In,
                          in_msg.addr, tbe);
                } else if (tbe.isDataless) {
                  trigger(Event:RspIn_RetryCompOnlyDataless_In,
                          in_msg.addr, tbe);
                } else if (tbe.isAtomic) {
                  trigger(Event:RspIn_RetryCompAtomic_In,
                          in_msg.addr, tbe);
                } else {
                  trigger(ev, in_msg.addr, tbe);
                }
              } else {
                trigger(ev, in_msg.addr, tbe);
              }
            } else {
              trigger(ev, in_msg.addr, tbe);
            }
          }
        } else {
          error("rspInPort: no TBE for response message");
        }
      }
    }
  }
}
bool rspInPort_stall() {
  error("rspInPort must never stall\n");
  return false;
}

// Rank 9: NoC Data
in_port(datInPort, CHIDataMsg, datIn, rank=9,
        rsc_stall_handler=datInPort_stall) {
  if (datInPort.isReady(clockEdge())) {
    printResources();
    peek(datInPort, CHIDataMsg) {
      if (isSnpRespDataType(in_msg.type)) {
        // Snoop data: non-directional, check snpTBEs first
        TBE tbe := snpTBEs[in_msg.addr];
        if (is_valid(tbe) == false) {
          tbe := lookupTBEByAddress(in_msg.addr);
        }
        if (is_valid(tbe) == false) {
          error("datInPort: no snoop TBE for data message");
        }
        if (tbe.state != State:SNP_WAIT_RESP) {
          DPRINTF(RubySlicc,
                  "datInPort: absorb stale snoop data addr=%#x type=%s responder=%s state=%s\n",
                  in_msg.addr, in_msg.type, in_msg.responder, tbe.state);
          datInPort.dequeue(clockEdge());
        } else {
          bool firstResponderData :=
            tbe.snpDataRespondersSeen.isElement(in_msg.responder) == false;
          int pendingAfter := tbe.pendingSnpResps;
          if ((firstResponderData == true) && (pendingAfter > 0)) {
            pendingAfter := pendingAfter - 1;
          }
          WriteMask combinedMask := tbe.dataBlkValid;
          if ((tbe.c2cSnpForwardDests.count() == 0) ||
              tbe.c2cSnpForwardDests.isElement(in_msg.responder)) {
            combinedMask.orMask(in_msg.bitMask);
          }
          bool finalData := combinedMask.isFull() && (pendingAfter == 0);
          if (finalData) {
            trigger(Event:DatIn_SnpRespData_In, in_msg.addr, tbe);
          } else {
            trigger(Event:DatIn_SnpRespData_More_In, in_msg.addr, tbe);
          }
        }
      } else {
        TBE tbe := lookupTBEByLocal(in_msg.responder, in_msg.txnId,
                                    in_msg.addr);
        if (is_valid(tbe) == false) {
          tbe := lookupTBEByLocalTxn(in_msg.txnId, in_msg.addr);
        }
        if (is_valid(tbe)) {
          if (tbe.isOutbound) {
            // Outbound TBE: write/atomic data from local RN going to C2C TX
            if (isWriteDataType(in_msg.type)) {
              DPRINTF(RubySlicc,
                      "datInPort outbound: addr=%#x type=%s state=%s reqType=%s storSlot=%d\n",
                      in_msg.addr, in_msg.type, tbe.state,
                      tbe.reqType, tbe.storSlot);
            }
            trigger(dataToEventOut(in_msg.type), in_msg.addr, tbe);
          } else if (isWriteDataType(in_msg.type)) {
            error("datInPort: write data matched inbound TBE");
          } else {
            // Inbound TBE: read/atomic response data from local HN going to C2C TX
            Event ev := dataToEventIn(in_msg.type);
            if (tbe.state == State:ACTIVE_WAIT_SEP) {
              if (tbe.expectingData &&
                  (ev == Event:DatIn_DataSepResp_In)) {
                trigger(Event:DatIn_SepReadData_Done_In,
                        in_msg.addr, tbe);
              } else if (tbe.expectingComp &&
                         ((ev == Event:DatIn_CompData_In) ||
                          (ev == Event:DatIn_DataSepResp_In))) {
                trigger(Event:DatIn_SepReadData_More_In,
                        in_msg.addr, tbe);
              } else {
                trigger(ev, in_msg.addr, tbe);
              }
            } else if ((tbe.state == State:RETRY_WAIT) &&
                       (ev == Event:DatIn_CompData_In)) {
              if (tbe.isRead) {
                trigger(Event:DatIn_RetryCompDataReq_In,
                        in_msg.addr, tbe);
              } else if (tbe.isAtomic) {
                trigger(Event:DatIn_RetryCompDataAtomic_In,
                        in_msg.addr, tbe);
              } else {
                trigger(ev, in_msg.addr, tbe);
              }
            } else {
              trigger(ev, in_msg.addr, tbe);
            }
          }
        } else {
          error("datInPort: no TBE for data message");
        }
      }
    }
  }
}
bool datInPort_stall() {
  error("datInPort must never stall\n");
  return false;
}

// Rank 7: C2C RX Snoop
in_port(c2cRxSnpInPort, CHIRequestMsg, c2cRxSnp, rank=7) {
  if (c2cRxSnpInPort.isReady(clockEdge())) {
    printResources();
    if (coherencyEnabled() == false) {
      c2cRxSnpInPort.recycle(clockEdge(),
                              cyclesToTicks(stall_recycle_lat));
    } else {
      peek(c2cRxSnpInPort, CHIRequestMsg) {
        if (isDvmSnoop(in_msg.type)) {
          if (isDvmP1(in_msg.type)) {
            if (storDvmTBEs.areNSlotsAvailable(1) == false) {
              c2cRxSnpInPort.recycle(clockEdge(),
                                      cyclesToTicks(stall_recycle_lat));
            } else {
              storDvmTBEs.incrementReserved();
              trigger(Event:InSnp_DvmP1, in_msg.addr,
                      dvmTBEs[in_msg.addr]);
            }
          } else {
            TBE dvm_tbe := dvmTBEs[in_msg.addr];
            if (is_valid(dvm_tbe) == false) {
              c2cRxSnpInPort.recycle(clockEdge(),
                                      cyclesToTicks(stall_recycle_lat));
            } else {
              trigger(Event:InSnp_DvmP2, in_msg.addr, dvm_tbe);
            }
          }
        } else if (storSnpTBEs.areNSlotsAvailable(1) == false) {
          c2cRxSnpInPort.recycle(clockEdge(),
                                  cyclesToTicks(stall_recycle_lat));
        } else {
          storSnpTBEs.incrementReserved();
          trigger(Event:InSnp_Deliver, in_msg.addr,
                  snpTBEs[in_msg.addr]);
        }
      }
    }
  }
}

// Rank 6: NoC Snoop (from local HN for remote targets, or MN for DVM)
// Credit check: outbound SNP requires C2C SNP credit (Phase 3)
// DVM snoops: P1 allocates a dvmTBE, P2 uses SNP credit for forwarding.
in_port(snpInPort, CHIRequestMsg, snpIn, rank=6) {
  if (snpInPort.isReady(clockEdge())) {
    printResources();
    peek(snpInPort, CHIRequestMsg) {
      if (isDvmSnoop(in_msg.type)) {
        if (dvmEnabled() == false) {
          snpInPort.recycle(clockEdge(),
                            cyclesToTicks(stall_recycle_lat));
        } else if (isDvmP1(in_msg.type)) {
          // P1: allocate dvmTBE and forward the first SnpDVM flit.
          // Reserve extra slot for sync if this is non-sync (T-010)
          int dvmSlotsNeeded := 1;
          if (isDvmSyncType(in_msg.type) == false) {
            dvmSlotsNeeded := 2;  // reserve 1 for potential sync
          }
          if (storDvmTBEs.areNSlotsAvailable(dvmSlotsNeeded) == false) {
            snpInPort.recycle(clockEdge(),
                              cyclesToTicks(stall_recycle_lat));
          } else if (creditMgr.hasSnpCredit() == false) {
            creditMgr.recordStall(1);  // CLS_SNP=1
            snpInPort.recycle(clockEdge(),
                              cyclesToTicks(stall_recycle_lat));
          } else {
            storDvmTBEs.incrementReserved();
            trigger(Event:OutSnp_DvmP1, in_msg.addr,
                    dvmTBEs[in_msg.addr]);
          }
        } else {
          if (creditMgr.hasSnpCredit() == false) {
            creditMgr.recordStall(1);  // CLS_SNP=1
            snpInPort.recycle(clockEdge(),
                              cyclesToTicks(stall_recycle_lat));
          } else {
            trigger(Event:OutSnp_DvmP2, in_msg.addr,
                    dvmTBEs[in_msg.addr]);
          }
        }
      } else if (coherencyEnabled() == false) {
        snpInPort.recycle(clockEdge(),
                          cyclesToTicks(stall_recycle_lat));
      } else if (creditMgr.hasSnpCredit() == false) {
        creditMgr.recordStall(1);  // CLS_SNP=1
        snpInPort.recycle(clockEdge(),
                          cyclesToTicks(stall_recycle_lat));
      } else if (storSnpTBEs.areNSlotsAvailable(1) == false) {
        snpInPort.recycle(clockEdge(),
                          cyclesToTicks(stall_recycle_lat));
      } else {
        storSnpTBEs.incrementReserved();
        trigger(Event:OutSnp_Forward, in_msg.addr,
                snpTBEs[in_msg.addr]);
      }
    }
  }
}

// Rank 5: Retry trigger
in_port(retryTriggerInPort, RetryTriggerMsg, retryTriggerQueue, rank=5) {
  if (retryTriggerInPort.isReady(clockEdge())) {
    printResources();
    peek(retryTriggerInPort, RetryTriggerMsg) {
      trigger(in_msg.event, in_msg.addr, nullTBE());
    }
  }
}

// Rank 4: Action trigger
in_port(triggerInPort, TriggerMsg, triggerQueue, rank=4) {
  if (triggerInPort.isReady(clockEdge())) {
    printResources();
    peek(triggerInPort, TriggerMsg) {
      trigger(in_msg.event, in_msg.addr, TBEs[in_msg.tbeKey]);
    }
  }
}

// Rank 3: Requests with TBE allocated (reqRdy)
// Credit check: outbound REQ requires C2C REQ credit (Phase 3)
in_port(reqRdyInPort, CHIRequestMsg, reqRdy, rank=3) {
  if (reqRdyInPort.isReady(clockEdge())) {
    printResources();
    if (coherencyEnabled() == false) {
      reqRdyInPort.recycle(clockEdge(),
                           cyclesToTicks(stall_recycle_lat));
    } else {
      peek(reqRdyInPort, CHIRequestMsg) {
        // Check C2C REQ credit before forwarding outbound request
        if (creditMgr.hasReqCredit(0) == false) {
          // No REQ credit: stall and retry next cycle
          DPRINTF(RubySlicc,
                  "reqRdyInPort stall: addr=%#x type=%s requestor=%s\n",
                  in_msg.addr, in_msg.type, in_msg.requestor);
          creditMgr.recordStall(0);  // CLS_REQ=0
          reqRdyInPort.recycle(clockEdge(),
                               cyclesToTicks(stall_recycle_lat));
        } else if (writepush_enabled == false &&
                   isWriteRequest(in_msg.type) &&
                   in_msg.type != CHIRequestType:WriteEvictFull &&
                   in_msg.type != CHIRequestType:WriteCleanFull) {
          // WritePull fallback for non-evict writes
          DPRINTF(RubySlicc,
                  "reqRdyInPort dispatch WritePull: addr=%#x type=%s requestor=%s\n",
                  in_msg.addr, in_msg.type, in_msg.requestor);
          trigger(Event:OutReq_WritePull, in_msg.addr,
              nullTBE());
        } else if (writepush_enabled == false &&
                   in_msg.type == CHIRequestType:WriteCleanFull) {
          // WriteCleanFull can get early Comp (no DBID), like
          // WriteEvictFull, but the request opcode stays WriteCleanFull.
          DPRINTF(RubySlicc,
              "reqRdyInPort dispatch WriteCleanNoPush: addr=%#x type=%s requestor=%s\n",
              in_msg.addr, in_msg.type, in_msg.requestor);
          trigger(Event:OutReq_WriteCleanNoPush, in_msg.addr,
              nullTBE());
        } else {
          DPRINTF(RubySlicc,
              "reqRdyInPort dispatch: addr=%#x type=%s requestor=%s\n",
              in_msg.addr, in_msg.type, in_msg.requestor);
          trigger(reqToEvent(in_msg.type), in_msg.addr,
              nullTBE());
        }
      }
    }
  }
}

// Rank 2: C2C RX Request
in_port(c2cRxReqInPort, CHIRequestMsg, c2cRxReq, rank=2) {
  if (c2cRxReqInPort.isReady(clockEdge())) {
    printResources();
    if (coherencyEnabled() == false) {
      c2cRxReqInPort.recycle(clockEdge(),
                              cyclesToTicks(stall_recycle_lat));
    } else {
      peek(c2cRxReqInPort, CHIRequestMsg) {
        DPRINTF(RubySlicc,
                "c2cRxReqInPort: addr=%#x type=%s requestor=%s origSrcID=%s\n",
                in_msg.addr, in_msg.type, in_msg.requestor,
                in_msg.origSrcID);
        if (storTBEs.areNSlotsAvailable(1)) {
          storTBEs.incrementReserved();
          // Map C2C request events
          if (isReadRequest(in_msg.type)) {
            trigger(Event:InReq_Read, in_msg.addr, nullTBE());
          } else if ((in_msg.type == CHIRequestType:WriteEvictFull) ||
                     (in_msg.type == CHIRequestType:WriteCleanFull)) {
            trigger(Event:InReq_EvictWrite, in_msg.addr,
                    nullTBE());
          } else if (isWriteRequest(in_msg.type) ||
                     isDvmRequest(in_msg.type)) {
            trigger(Event:InReq_Write, in_msg.addr, nullTBE());
          } else if (isAtomicRequest(in_msg.type)) {
            trigger(Event:InReq_Atomic, in_msg.addr, nullTBE());
          } else if (in_msg.type == CHIRequestType:CleanUnique) {
            trigger(Event:InReq_CleanUnique, in_msg.addr, nullTBE());
          } else if (isCompOnlyDatalessRequest(in_msg.type)) {
            trigger(Event:InReq_Evict, in_msg.addr, nullTBE());
          } else {
            error("Invalid CHIRequestType for C2CG c2cRxReqInPort");
          }
        } else {
          // Cannot send RetryAck across C2C; stall
          c2cRxReqInPort.recycle(clockEdge(),
                                  cyclesToTicks(stall_recycle_lat));
        }
      }
    }
  }
}

// Rank 1: NoC Request (lowest priority)
in_port(reqInPort, CHIRequestMsg, reqIn, rank=1) {
  if (reqInPort.isReady(clockEdge())) {
    printResources();
    if (coherencyEnabled() == false) {
      reqInPort.recycle(clockEdge(),
                        cyclesToTicks(stall_recycle_lat));
    } else {
      peek(reqInPort, CHIRequestMsg) {
        DPRINTF(RubySlicc,
                "reqInPort: addr=%#x type=%s requestor=%s allowRetry=%d\n",
                in_msg.addr, in_msg.type, in_msg.requestor,
                in_msg.allowRetry);
        TBE merge_tbe := lookupTBEByAddress(in_msg.addr);
        if (readmerge_enabled &&
          canMergeLocalRead(merge_tbe, in_msg.type,
                    in_msg.requestor)) {
          trigger(Event:OutReq_MergeReadShared, in_msg.addr, merge_tbe);
        } else if (in_msg.allowRetry) {
          trigger(Event:CheckAllocTBE, in_msg.addr, nullTBE());
        } else {
          trigger(Event:CheckAllocTBE_WithCredit,
                  in_msg.addr, nullTBE());
        }
      }
    }
  }
}
