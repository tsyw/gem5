// CHI C2C Gateway helper functions

////////////////////////////////////////////////////////////////////////////
// External functions
////////////////////////////////////////////////////////////////////////////

Tick clockEdge();
Tick curTick();
Tick cyclesToTicks(Cycles c);
void set_tbe(TBE b);
void unset_tbe();
void wakeUpAllBuffers(Addr a);
MachineID mapAddressToDownstreamMachine(Addr addr);
MachineID mapAddressToDownstreamMachine(Addr addr, MachineType mtype);
NetDest allUpstreamDest();
NetDest allPeerUpstreamDest();

////////////////////////////////////////////////////////////////////////////
// Interface functions required by SLICC
////////////////////////////////////////////////////////////////////////////

Addr tbeSlotKey(int slot) {
  return intToAddress(slot * blockSize);
}

Addr tbeKey(TBE tbe) {
  assert(is_valid(tbe));
  return tbeSlotKey(tbe.storSlot);
}

TBE nullTBE(), return_by_pointer="yes" {
  return OOD;
}

TBE lookupTBEByC2COut(Addr txnId), return_by_pointer="yes" {
  if (txnKeyTable.hasC2COut(txnId)) {
    return TBEs[txnKeyTable.lookupC2COut(txnId)];
  }
  return nullTBE();
}

TBE lookupTBEByC2CInScoped(MachineID peer, Addr txnId, Addr addr),
    return_by_pointer="yes" {
  if (txnKeyTable.hasC2CInScoped(peer, txnId, addr)) {
    return TBEs[txnKeyTable.lookupC2CInScoped(peer, txnId, addr)];
  }
  return nullTBE();
}

TBE lookupTBEByLocal(MachineID src, Addr txnId, Addr addr),
    return_by_pointer="yes" {
  if (txnKeyTable.hasLocal(src, txnId, addr)) {
    return TBEs[txnKeyTable.lookupLocal(src, txnId, addr)];
  }
  return nullTBE();
}

TBE lookupTBEByLocalTxn(Addr txnId, Addr addr), return_by_pointer="yes" {
  if (txnKeyTable.hasLocalTxn(txnId)) {
    TBE local_tbe := TBEs[txnKeyTable.lookupLocalTxn(txnId)];
    if (local_tbe.addr == addr) {
      return local_tbe;
    }
  }
  return nullTBE();
}

TBE lookupTBEByAddress(Addr addr), return_by_pointer="yes" {
  if (txnKeyTable.hasAddress(addr)) {
    return TBEs[txnKeyTable.lookupAddress(addr)];
  }
  return nullTBE();
}

State getState(TBE tbe, Addr addr) {
  if (is_valid(tbe)) {
    return tbe.state;
  }
  // Check DVM TBE table (uses different address space)
  TBE dvmTbe := dvmTBEs[addr];
  if (is_valid(dvmTbe)) {
    return dvmTbe.state;
  }
  return State:I;
}

void setState(TBE tbe, Addr addr, State state) {
  if (is_valid(tbe)) {
    tbe.state := state;
  }
}

AccessPermission getAccessPermission(Addr addr) {
  TBE tbe := lookupTBEByAddress(addr);
  if (is_valid(tbe)) {
    return CHI_C2C_State_to_permission(tbe.state);
  }
  TBE dvmTbe := dvmTBEs[addr];
  if (is_valid(dvmTbe)) {
    return CHI_C2C_State_to_permission(dvmTbe.state);
  }
  return AccessPermission:NotPresent;
}

void setAccessPermission(Addr addr, State state) {
}

void functionalRead(Addr addr, Packet *pkt, WriteMask &mask) {
  TBE tbe := lookupTBEByAddress(addr);
  if (is_valid(tbe)) {
    testAndReadMask(addr, tbe.dataBlk, mask, pkt);
  }
  // DVM TBEs carry no coherent data; skip dvmTBEs probe
}

int functionalWrite(Addr addr, Packet *pkt) {
  int num_functional_writes := 0;
  TBE tbe := lookupTBEByAddress(addr);
  if (is_valid(tbe)) {
    num_functional_writes := num_functional_writes +
      testAndWrite(addr, tbe.dataBlk, pkt);
  }
  // DVM TBEs carry no coherent data; skip dvmTBEs probe
  return num_functional_writes;
}

////////////////////////////////////////////////////////////////////////////
// Helper functions
////////////////////////////////////////////////////////////////////////////

// Interface state guard checks (Phase 5)
bool coherencyEnabled() {
  return (interfaceState == InterfaceState:IF_RUN) &&
         (cohState == CoherencyState:COH_ENABLED);
}

bool dvmEnabled() {
  return dvm_support && coherencyEnabled() &&
         (dvmState == DVMDomainState:DVM_ENABLED);
}

void printResources() {
  DPRINTF(RubySlicc, "Resources(avail/max): TBEs=%d/%d snpTBEs=%d/%d dvmTBEs=%d/%d\n",
                storTBEs.size(), storTBEs.capacity(),
                storSnpTBEs.size(), storSnpTBEs.capacity(),
                storDvmTBEs.size(), storDvmTBEs.capacity());
}

// Dataless requests whose Comp is terminal in the supported C2CG subset.
bool isCompOnlyDatalessRequest(CHIRequestType type) {
  if (type == CHIRequestType:Evict) {
    return true;
  }
  return false;
}

// Event mapping: CHI request type -> C2CG event
Event reqToEvent(CHIRequestType type) {
  if ((type == CHIRequestType:ReadShared) ||
      (type == CHIRequestType:ReadUnique) ||
      (type == CHIRequestType:ReadOnce) ||
      (type == CHIRequestType:ReadNoSnp) ||
      (type == CHIRequestType:ReadNoSnpSep) ||
      (type == CHIRequestType:ReadNotSharedDirty)) {
    return Event:OutReq_Read;
  } else if (type == CHIRequestType:CleanUnique) {
    return Event:OutReq_CleanUnique;
  } else if ((type == CHIRequestType:WriteUniqueFull) ||
             (type == CHIRequestType:WriteUniquePtl) ||
             (type == CHIRequestType:WriteNoSnp) ||
             (type == CHIRequestType:WriteNoSnpPtl)) {
    if (writepush_enabled) {
      return Event:OutReq_WritePush;
    }
    return Event:OutReq_Write;
  } else if ((type == CHIRequestType:WriteBackFull) ||
             (type == CHIRequestType:WriteCleanFull) ||
             (type == CHIRequestType:WriteEvictFull)) {
    return Event:OutReq_Write;
  } else if ((type == CHIRequestType:DvmOpNonSync) ||
             (type == CHIRequestType:DvmOpSync)) {
    return Event:OutReq_Write;
  } else if (isCompOnlyDatalessRequest(type)) {
    return Event:OutReq_Evict;
  } else if ((type == CHIRequestType:AtomicReturn) ||
             (type == CHIRequestType:AtomicNoReturn)) {
    return Event:OutReq_Atomic;
  } else {
    error("Invalid CHIRequestType for C2CG reqToEvent");
  }
}

// Check if a CHI response type is a snoop response.
// Used to prioritize snpTBE lookup over TBE lookup in response ports,
// preventing collision when both tables have entries for the same address.
bool isSnpRespType(CHIResponseType type) {
  if ((type == CHIResponseType:SnpResp_I) ||
      (type == CHIResponseType:SnpResp_SC) ||
      (type == CHIResponseType:SnpResp_I_Fwded_UC) ||
      (type == CHIResponseType:SnpResp_I_Fwded_UD_PD) ||
      (type == CHIResponseType:SnpResp_SC_Fwded_SC) ||
      (type == CHIResponseType:SnpResp_SC_Fwded_SD_PD) ||
      (type == CHIResponseType:SnpResp_UC_Fwded_I) ||
      (type == CHIResponseType:SnpResp_UD_Fwded_I) ||
      (type == CHIResponseType:SnpResp_SC_Fwded_I) ||
      (type == CHIResponseType:SnpResp_SD_Fwded_I)) {
    return true;
  }
  return false;
}

// Check if a CHI data type is a snoop response data.
bool isSnpRespDataType(CHIDataType type) {
  if ((type == CHIDataType:SnpRespData_I) ||
      (type == CHIDataType:SnpRespData_I_PD) ||
      (type == CHIDataType:SnpRespData_SC) ||
      (type == CHIDataType:SnpRespData_SC_PD) ||
      (type == CHIDataType:SnpRespData_SD) ||
      (type == CHIDataType:SnpRespData_UC) ||
      (type == CHIDataType:SnpRespData_UD) ||
      (type == CHIDataType:SnpRespData_SC_Fwded_SC) ||
      (type == CHIDataType:SnpRespData_SC_Fwded_SD_PD) ||
      (type == CHIDataType:SnpRespData_SC_PD_Fwded_SC) ||
      (type == CHIDataType:SnpRespData_SD_Fwded_SC) ||
      (type == CHIDataType:SnpRespData_I_Fwded_SD_PD) ||
      (type == CHIDataType:SnpRespData_I_PD_Fwded_SC) ||
      (type == CHIDataType:SnpRespData_I_Fwded_SC)) {
    return true;
  }
  return false;
}

// Event mapping: CHI response type -> C2CG event
Event respToEvent(CHIResponseType type) {
  if (type == CHIResponseType:Comp_I) {
    return Event:RspIn_Comp;
  } else if (type == CHIResponseType:Comp_UC) {
    return Event:RspIn_Comp;
  } else if (type == CHIResponseType:Comp_SC) {
    return Event:RspIn_Comp;
  } else if (type == CHIResponseType:Comp_UD_PD) {
    return Event:RspIn_Comp;
  } else if (type == CHIResponseType:Comp) {
    return Event:RspIn_Comp;
  } else if (type == CHIResponseType:CompDBIDResp) {
    return Event:RspIn_CompDBIDResp;
  } else if (type == CHIResponseType:DBIDResp) {
    return Event:RspIn_DBIDResp;
  } else if (type == CHIResponseType:CompAck) {
    return Event:RspIn_CompAck;
  } else if (type == CHIResponseType:ReadReceipt) {
    return Event:RspIn_ReadReceipt;
  } else if (type == CHIResponseType:RespSepData) {
    return Event:RspIn_RespSepData;
  } else if (type == CHIResponseType:RetryAck) {
    return Event:RetryAckFromHN;
  } else if (type == CHIResponseType:PCrdGrant) {
    return Event:PCrdGrantFromHN;
  } else if (type == CHIResponseType:SnpResp_I) {
    return Event:RspIn_SnpResp_Out;
  } else if (type == CHIResponseType:SnpResp_SC) {
    return Event:RspIn_SnpResp_Out;
  } else if (type == CHIResponseType:SnpResp_I_Fwded_UC) {
    return Event:RspIn_SnpResp_Out;
  } else if (type == CHIResponseType:SnpResp_I_Fwded_UD_PD) {
    return Event:RspIn_SnpResp_Out;
  } else if (type == CHIResponseType:SnpResp_SC_Fwded_SC) {
    return Event:RspIn_SnpResp_Out;
  } else if (type == CHIResponseType:SnpResp_SC_Fwded_SD_PD) {
    return Event:RspIn_SnpResp_Out;
  } else if (type == CHIResponseType:SnpResp_UC_Fwded_I) {
    return Event:RspIn_SnpResp_Out;
  } else if (type == CHIResponseType:SnpResp_UD_Fwded_I) {
    return Event:RspIn_SnpResp_Out;
  } else if (type == CHIResponseType:SnpResp_SC_Fwded_I) {
    return Event:RspIn_SnpResp_Out;
  } else if (type == CHIResponseType:SnpResp_SD_Fwded_I) {
    return Event:RspIn_SnpResp_Out;
  } else {
    error("Invalid CHIResponseType for C2CG respToEvent");
  }
}

// Event mapping: CHI data type -> C2CG event
// Only handles non-directional types (snoop data and WrReqData).
// Directional data types (CompData, DataSepResp, CBWrData, NCBWrData)
// use dataToEventOut() / dataToEventIn() based on tbe.isOutbound.
Event dataToEvent(CHIDataType type) {
  if (type == CHIDataType:SnpRespData_I) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_I_PD) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_SC) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_SC_PD) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_SD) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_UC) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_UD) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_SC_Fwded_SC) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_SC_Fwded_SD_PD) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_SC_PD_Fwded_SC) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_SD_Fwded_SC) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_I_Fwded_SD_PD) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_I_PD_Fwded_SC) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:SnpRespData_I_Fwded_SC) {
    return Event:DatIn_SnpRespData_Out;
  } else if (type == CHIDataType:WrReqDataS) {
    return Event:DatIn_WrReqData;
  } else if (type == CHIDataType:WrReqDataL) {
    return Event:DatIn_WrReqData;
  } else {
    error("Invalid CHIDataType for C2CG dataToEvent (use dataToEventOut/In for directional types)");
  }
}

// Check if a CHI data type is a WritePush WrReqData message
bool isWrReqDataType(CHIDataType type) {
  return (type == CHIDataType:WrReqDataS) || (type == CHIDataType:WrReqDataL);
}

bool isWriteDataType(CHIDataType type) {
  return ((type == CHIDataType:CBWrData_UC) ||
          (type == CHIDataType:CBWrData_SC) ||
          (type == CHIDataType:CBWrData_UD_PD) ||
          (type == CHIDataType:CBWrData_SD_PD) ||
          (type == CHIDataType:CBWrData_I) ||
          (type == CHIDataType:NCBWrData));
}

TBE lookupNoCDataTBE(CHIDataType type, MachineID responder,
                     Addr txnId, Addr addr), return_by_pointer="yes" {
  if (isWriteDataType(type)) {
    return lookupTBEByLocal(responder, txnId, addr);
  }
  return lookupTBEByLocalTxn(txnId, addr);
}

// Determine if a request type is a read
bool isReadRequest(CHIRequestType type) {
  if ((type == CHIRequestType:ReadShared) ||
      (type == CHIRequestType:ReadUnique) ||
      (type == CHIRequestType:ReadOnce) ||
      (type == CHIRequestType:ReadNoSnp) ||
      (type == CHIRequestType:ReadNoSnpSep) ||
      (type == CHIRequestType:ReadNotSharedDirty)) {
    return true;
  }
  return false;
}

// Determine if a request type is a write
bool isWriteRequest(CHIRequestType type) {
  if ((type == CHIRequestType:WriteUniqueFull) ||
      (type == CHIRequestType:WriteUniquePtl) ||
      (type == CHIRequestType:WriteBackFull) ||
      (type == CHIRequestType:WriteCleanFull) ||
      (type == CHIRequestType:WriteEvictFull) ||
      (type == CHIRequestType:WriteNoSnp) ||
      (type == CHIRequestType:WriteNoSnpPtl)) {
    return true;
  }
  return false;
}

bool writeCompRequired(CHIRequestType type) {
  return type != CHIRequestType:WriteBackFull;
}

MachineID localRequestDest(CHIRequestMsg msg, Addr addr) {
  if ((msg.type == CHIRequestType:DvmOpNonSync) ||
      (msg.type == CHIRequestType:DvmOpSync)) {
    return mapAddressToDownstreamMachine(addr, MachineType:MiscNode);
  }
  if (msg.hasC2CEgressType) {
    return mapAddressToDownstreamMachine(addr, msg.c2cEgressType);
  }
  return mapAddressToDownstreamMachine(addr, MachineType:Cache);
}

MachineID localRequestDest(CHIDataMsg msg, Addr addr) {
  if (msg.hasC2CEgressType) {
    return mapAddressToDownstreamMachine(addr, msg.c2cEgressType);
  }
  return mapAddressToDownstreamMachine(addr, MachineType:Cache);
}

CHIDataType localWriteDataType(CHIRequestType type) {
  if ((type == CHIRequestType:WriteNoSnp) ||
      (type == CHIRequestType:WriteNoSnpPtl)) {
    return CHIDataType:NCBWrData;
  }
  return CHIDataType:CBWrData_I;
}

// Determine if a request type is dataless
bool isDatalessRequest(CHIRequestType type) {
  if ((type == CHIRequestType:CleanUnique) ||
      isCompOnlyDatalessRequest(type)) {
    return true;
  }
  return false;
}

bool needsRequesterCompAck(CHIRequestType type) {
  if ((type == CHIRequestType:ReadNoSnp) ||
      (type == CHIRequestType:ReadNoSnpSep)) {
    return false;
  }
  if (isReadRequest(type) || type == CHIRequestType:CleanUnique) {
    return true;
  }
  return false;
}

bool canMergeLocalRead(TBE merge_tbe, CHIRequestType type,
                       MachineID requestor) {
  if (is_valid(merge_tbe) == false) {
    return false;
  }
  if (type != CHIRequestType:ReadShared) {
    return false;
  }
  if (merge_tbe.reqType != CHIRequestType:ReadShared) {
    return false;
  }
  if (merge_tbe.isOutbound == false) {
    return false;
  }
  if (merge_tbe.state != State:REQ_ACTIVE) {
    return false;
  }
  if (merge_tbe.expectingData == false || merge_tbe.expectingComp) {
    return false;
  }
  if (merge_tbe.rxtxBytes != 0 || merge_tbe.compAckDone) {
    return false;
  }
  if (merge_tbe.readFanoutDests.isElement(requestor)) {
    return false;
  }
  return true;
}

NetDest localResponseDest(TBE tbe) {
  NetDest dest;
  if (tbe.isOutbound && tbe.isRead &&
      tbe.readFanoutDests.count() > 0) {
    dest := tbe.readFanoutDests;
  } else {
    dest.add(tbe.localSrcID);
  }
  return dest;
}

NetDest localDataDest(TBE tbe) {
  NetDest dest;
  if (tbe.dataToFwdRequestor) {
    dest.add(tbe.localFwdRequestor);
  } else {
    dest := localResponseDest(tbe);
  }
  return dest;
}

// Determine if a request type is atomic
bool isAtomicRequest(CHIRequestType type) {
  if ((type == CHIRequestType:AtomicReturn) ||
      (type == CHIRequestType:AtomicNoReturn)) {
    return true;
  }
  return false;
}

////////////////////////////////////////////////////////////////////////////
// DVM helper functions (Phase 4)
////////////////////////////////////////////////////////////////////////////

bool isDvmP1(CHIRequestType type) {
  if ((type == CHIRequestType:SnpDvmOpSync_P1) ||
      (type == CHIRequestType:SnpDvmOpNonSync_P1)) {
    return true;
  }
  return false;
}

bool isDvmP2(CHIRequestType type) {
  if ((type == CHIRequestType:SnpDvmOpSync_P2) ||
      (type == CHIRequestType:SnpDvmOpNonSync_P2)) {
    return true;
  }
  return false;
}

bool isDvmSnoop(CHIRequestType type) {
  return isDvmP1(type) || isDvmP2(type);
}

bool isDvmSyncType(CHIRequestType type) {
  if ((type == CHIRequestType:SnpDvmOpSync_P1) ||
      (type == CHIRequestType:SnpDvmOpSync_P2) ||
      (type == CHIRequestType:DvmOpSync)) {
    return true;
  }
  return false;
}

bool isDvmRequest(CHIRequestType type) {
  if ((type == CHIRequestType:DvmOpNonSync) ||
      (type == CHIRequestType:DvmOpSync)) {
    return true;
  }
  return false;
}

Event c2cReqToEvent(CHIRequestType type) {
  if (isReadRequest(type)) {
    return Event:InReq_Read;
  } else if (isWriteRequest(type) || isDvmRequest(type)) {
    return Event:InReq_Write;
  } else if (isAtomicRequest(type)) {
    return Event:InReq_Atomic;
  } else if (type == CHIRequestType:CleanUnique) {
    return Event:InReq_CleanUnique;
  } else if (isCompOnlyDatalessRequest(type)) {
    return Event:InReq_Evict;
  } else {
    error("Invalid CHIRequestType for C2CG c2cReqToEvent");
  }
}

Event outSnpToEvent(CHIRequestType type) {
  if (isDvmSnoop(type)) {
    if (isDvmP1(type)) {
      return Event:OutSnp_DvmP1;
    }
    return Event:OutSnp_DvmP2;
  }
  return Event:OutSnp_Forward;
}

Event inSnpToEvent(CHIRequestType type) {
  if (isDvmSnoop(type)) {
    if (isDvmP1(type)) {
      return Event:InSnp_DvmP1;
    }
    return Event:InSnp_DvmP2;
  }
  return Event:InSnp_Deliver;
}

bool shouldExpandReadMergedSnpTargets(CHIRequestType type, bool retToSrc) {
  if (type == CHIRequestType:SnpCleanInvalid) {
    return true;
  }
  if ((type == CHIRequestType:SnpUnique) && (retToSrc == false)) {
    return true;
  }
  return false;
}

bool allowsMultipleSnpDataResponders(CHIRequestType type, bool retToSrc) {
  return shouldExpandReadMergedSnpTargets(type, retToSrc);
}

// Shared TBE field initialization (avoids triplicated defaults)
void clearTBEDefaults(TBE tbe) {
  tbe.isRead := false;
  tbe.isWrite := false;
  tbe.isSnoop := false;
  tbe.isDVM := false;
  tbe.isDataless := false;
  tbe.isAtomic := false;
  tbe.isOutbound := false;
  tbe.txnID := intToAddress(0);
  tbe.retryPending := false;
  tbe.retryGrantPending := false;
  tbe.retryState := State:I;
  tbe.writeCompReceived := false;
  tbe.expectingData := false;
  tbe.expectingComp := false;
  tbe.sepReadCompleteTriggered := false;
  tbe.resPlane := 0;
  tbe.usedSharedCredit := false;
  tbe.dataBlk.clear();
  tbe.dataBlkValid.clear();
  tbe.rxtxBytes := 0;
  tbe.dataBytesExpected := blockSize;
  tbe.pendingSnpResps := 0;
  tbe.pendingSnpDataBytes := 0;
  tbe.c2cSnpResponsesToForward := 0;
  tbe.c2cSnpForwardDests.clear();
  tbe.snpDataRespondersSeen.clear();
  tbe.allowMultipleSnpDataResponders := false;
  tbe.hasSnpDataCopyResponder := false;
  tbe.snpDataCopyResponder := machineID;
  tbe.compAckDone := false;
  tbe.pendingCompAcks := 0;
  tbe.readFanoutDests.clear();
  tbe.dataToFwdRequestor := false;
  tbe.hasC2CEgressType := false;
}

void assignTxnID(TBE tbe) {
  tbe.txnID := nextTxnID;
  nextTxnID := intToAddress(addressToInt(nextTxnID) + 1);
  if (nextTxnID == intToAddress(0)) {
    nextTxnID := intToAddress(1);
  }
}

// Directional event mapping: outbound context (C2C RX RSP or CompAck from local RN)
// These events return credits to the C2C credit pool.
Event respToEventOut(CHIResponseType type) {
  if ((type == CHIResponseType:Comp_I) ||
      (type == CHIResponseType:Comp_UC) ||
      (type == CHIResponseType:Comp_SC) ||
      (type == CHIResponseType:Comp_UD_PD) ||
      (type == CHIResponseType:Comp)) {
    return Event:RspIn_Comp_Out;
  } else if (type == CHIResponseType:CompDBIDResp) {
    return Event:RspIn_CompDBIDResp_Out;
  } else if (type == CHIResponseType:DBIDResp) {
    return Event:RspIn_DBIDResp_Out;
  } else if (type == CHIResponseType:CompAck) {
    return Event:RspIn_CompAck_Out;
  } else if (type == CHIResponseType:ReadReceipt) {
    return Event:RspIn_ReadReceipt_Out;
  } else if (type == CHIResponseType:RespSepData) {
    return Event:RspIn_RespSepData_Out;
  } else {
    error("Invalid CHIResponseType for respToEventOut");
  }
}

// Directional event mapping: inbound context (NoC RSP or CompAck from remote)
// These events consume credits from the C2C credit pool.
Event respToEventIn(CHIResponseType type) {
  if ((type == CHIResponseType:Comp_I) ||
      (type == CHIResponseType:Comp_UC) ||
      (type == CHIResponseType:Comp_SC) ||
      (type == CHIResponseType:Comp_UD_PD) ||
      (type == CHIResponseType:Comp)) {
    return Event:RspIn_Comp_In;
  } else if (type == CHIResponseType:CompDBIDResp) {
    return Event:RspIn_CompDBIDResp_In;
  } else if (type == CHIResponseType:DBIDResp) {
    return Event:RspIn_DBIDResp_In;
  } else if (type == CHIResponseType:CompAck) {
    return Event:RspIn_CompAck_In;
  } else if (type == CHIResponseType:ReadReceipt) {
    return Event:RspIn_ReadReceipt_In;
  } else if (type == CHIResponseType:RespSepData) {
    return Event:RspIn_RespSepData_In;
  } else {
    error("Invalid CHIResponseType for respToEventIn");
  }
}

// Directional data event mapping: outbound context
// (C2C RX DAT for read responses, or NoC DAT for local write/atomic data)
Event dataToEventOut(CHIDataType type) {
  if ((type == CHIDataType:CompData_I) ||
      (type == CHIDataType:CompData_UC) ||
      (type == CHIDataType:CompData_SC) ||
      (type == CHIDataType:CompData_UD_PD) ||
      (type == CHIDataType:CompData_SD_PD)) {
    return Event:DatIn_CompData_Out;
  } else if (type == CHIDataType:DataSepResp_UC) {
    return Event:DatIn_DataSepResp_Out;
  } else if ((type == CHIDataType:CBWrData_UC) ||
             (type == CHIDataType:CBWrData_SC) ||
             (type == CHIDataType:CBWrData_UD_PD) ||
             (type == CHIDataType:CBWrData_SD_PD) ||
             (type == CHIDataType:CBWrData_I)) {
    return Event:DatIn_CBWrData_Out;
  } else if (type == CHIDataType:NCBWrData) {
    return Event:DatIn_NCBWrData_Out;
  } else {
    error("Invalid CHIDataType for dataToEventOut");
  }
}

// Directional data event mapping: inbound context
// (NoC DAT for read responses from local HN, or C2C RX DAT for write data)
Event dataToEventIn(CHIDataType type) {
  if ((type == CHIDataType:CompData_I) ||
      (type == CHIDataType:CompData_UC) ||
      (type == CHIDataType:CompData_SC) ||
      (type == CHIDataType:CompData_UD_PD) ||
      (type == CHIDataType:CompData_SD_PD)) {
    return Event:DatIn_CompData_In;
  } else if (type == CHIDataType:DataSepResp_UC) {
    return Event:DatIn_DataSepResp_In;
  } else if ((type == CHIDataType:CBWrData_UC) ||
             (type == CHIDataType:CBWrData_SC) ||
             (type == CHIDataType:CBWrData_UD_PD) ||
             (type == CHIDataType:CBWrData_SD_PD) ||
             (type == CHIDataType:CBWrData_I)) {
    return Event:DatIn_CBWrData_In;
  } else if (type == CHIDataType:NCBWrData) {
    return Event:DatIn_NCBWrData_In;
  } else {
    error("Invalid CHIDataType for dataToEventIn");
  }
}

Event rspInDispatchEvent(CHIResponseType type, TBE tbe) {
  assert(is_valid(tbe));
  if (isSnpRespType(type)) {
    assert(tbe.state == State:SNP_WAIT_RESP);
    return Event:RspIn_SnpResp_In;
  } else if (tbe.isOutbound) {
    return respToEventOut(type);
  } else {
    Event ev := respToEventIn(type);
    if (tbe.state == State:RETRY_WAIT) {
      if (ev == Event:RspIn_CompDBIDResp_In) {
        error("rspInDispatchEvent: CompDBIDResp in RETRY_WAIT");
      } else if (ev == Event:RspIn_Comp_In) {
        if (tbe.retryState == State:WR_PUSH_FWD_WAIT_DBID) {
          return Event:RspIn_RetryCompWritePush_In;
        } else if (tbe.isWrite) {
          return Event:RspIn_RetryCompWrite_In;
        } else if (tbe.isDataless &&
                   needsRequesterCompAck(tbe.reqType)) {
          return Event:RspIn_RetryCompAckDataless_In;
        } else if (tbe.isDataless) {
          return Event:RspIn_RetryCompOnlyDataless_In;
        } else if (tbe.isAtomic) {
          return Event:RspIn_RetryCompAtomic_In;
        }
      }
    }
    return ev;
  }
}

Event datInDispatchEvent(CHIDataType type, TBE tbe) {
  assert(is_valid(tbe));
  if (isSnpRespDataType(type)) {
    assert(tbe.state == State:SNP_WAIT_RESP);
    return Event:DatIn_SnpRespData_In;
  } else if (tbe.isOutbound) {
    return dataToEventOut(type);
  } else if (isWriteDataType(type)) {
    error("datInDispatchEvent: write data matched inbound TBE");
  } else {
    Event ev := dataToEventIn(type);
    if ((tbe.state == State:RETRY_WAIT) &&
        (ev == Event:DatIn_CompData_In)) {
      if (tbe.isRead) {
        return Event:DatIn_RetryCompDataReq_In;
      } else if (tbe.isAtomic) {
        return Event:DatIn_RetryCompDataAtomic_In;
      }
    }
    return ev;
  }
}

// Check if all data flits for a cache line have been forwarded
bool allDataFlitsForwarded(TBE tbe) {
  return tbe.rxtxBytes >= tbe.dataBytesExpected;
}
