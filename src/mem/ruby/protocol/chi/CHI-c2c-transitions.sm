// CHI C2C Gateway transition table
// HR-4: 8 outbound/inbound state pairs merged into bidirectional states.
// Direction tracked via tbe.isOutbound + _Out/_In event split at port handlers.
//
// State count: 18 total states (including I)
//
// Credit rules (Decision D5):
//   Consume: when message is enqueued to C2C TX buffer
//   Return: when message is dequeued from C2C RX buffer
//
// _Out events: arrive from C2C RX (outbound TBE) → return C2C credits
// _In  events: arrive from local NoC (inbound TBE) → consume C2C credits
//
// Consume actions are placed BEFORE the forwarding action.
// Return actions are placed BEFORE the pop action.

// All states for wildcard transition lists (I plus 17 active states)
// I, REQ_ACTIVE, ACTIVE_WAIT_SEP,
// WR_ACTIVE_DBID, WR_WAIT_COMP,
// COMPACK_ACTIVE, COMPACK_DL_ACTIVE,
// COMP_ONLY_DL_ACTIVE, ATOMIC_ACTIVE,
// RETRY_WAIT,
// SNP_WAIT_RESP,
// DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
// WR_PUSH_WAIT_DATA, WR_PUSH_SENT, WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP

////////////////////////////////////////////////////////////////////////////
// TBE allocation from NoC requests
////////////////////////////////////////////////////////////////////////////

transition({I, REQ_ACTIVE, ACTIVE_WAIT_SEP,
            WR_ACTIVE_DBID, WR_WAIT_COMP,
            COMPACK_ACTIVE, COMPACK_DL_ACTIVE,
            COMP_ONLY_DL_ACTIVE, ATOMIC_ACTIVE,
            RETRY_WAIT,
            SNP_WAIT_RESP,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           CheckAllocTBE) {
  checkAllocateTBE;
}

transition({I, REQ_ACTIVE, ACTIVE_WAIT_SEP,
            WR_ACTIVE_DBID, WR_WAIT_COMP,
            COMPACK_ACTIVE, COMPACK_DL_ACTIVE,
            COMP_ONLY_DL_ACTIVE, ATOMIC_ACTIVE,
            RETRY_WAIT,
            SNP_WAIT_RESP,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           CheckAllocTBE_WithCredit) {
  checkAllocateTBE_withCredit;
}

////////////////////////////////////////////////////////////////////////////
// Outbound read flow: local RN -> C2CG -> C2C -> remote HN
// Consume: REQ credit on send
// Return: RSP/DAT credit on C2C RX dequeue
////////////////////////////////////////////////////////////////////////////

transition(I, {OutReq_ReadShared, OutReq_ReadUnique, OutReq_ReadOnce,
               OutReq_ReadNoSnp, OutReq_ReadNotSharedDirty},
           REQ_ACTIVE) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  setExpectingData;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

transition(REQ_ACTIVE, OutReq_MergeReadShared) {
  attachMergedReadFromReq;
  popReqInQueue;
}

// Inbound read flow: remote RN -> peer C2CG -> C2C -> this C2CG -> local HN
// Return: REQ credit on C2C RX REQ dequeue
// Consume: RSP/DAT credit on send to C2C TX
transition(I, InReq_Read, REQ_ACTIVE) {
  allocateTBE;
  recordRemoteIDs_fromC2CReq;
  setExpectingData;
  forwardC2CReqToLocal;
  returnReqCredit;
  popC2CRxReqQueue;
}

// CompData from remote HN via C2C RX (outbound TBE)
transition(REQ_ACTIVE, DatIn_CompData_Out, COMPACK_ACTIVE) {
  clearExpectingData;
  trackDatFlit;
  forwardC2CDatToLocal;
  returnDatCredit;
  checkTxnComplete;
  popC2CRxDatQueue;
}

// CompData from local HN via NoC DAT (inbound TBE)
transition(REQ_ACTIVE, DatIn_CompData_In, COMPACK_ACTIVE) {
  clearExpectingData;
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  checkTxnComplete;
  popDatInQueue;
}

// Separated: DataSepResp first from C2C RX (outbound TBE)
transition(REQ_ACTIVE, DatIn_DataSepResp_Out, ACTIVE_WAIT_SEP) {
  clearExpectingData;
  setExpectingComp;
  trackDatFlit;
  forwardC2CDatToLocal;
  returnDatCredit;
  popC2CRxDatQueue;
}

// Separated: DataSepResp first from local HN (inbound TBE)
transition(REQ_ACTIVE, DatIn_DataSepResp_In, ACTIVE_WAIT_SEP) {
  clearExpectingData;
  setExpectingComp;
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  popDatInQueue;
}

// Separated: RespSepData first from C2C RX (outbound TBE)
transition(REQ_ACTIVE, RspIn_RespSepData_Out, ACTIVE_WAIT_SEP) {
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// Separated: RespSepData first from local HN (inbound TBE)
transition(REQ_ACTIVE, RspIn_RespSepData_In, ACTIVE_WAIT_SEP) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

// ReadReceipt: outbound only (from C2C RX, forward to local RN)
// HR-6a: ReadReceipt must be forwarded to local RN
transition({REQ_ACTIVE, ACTIVE_WAIT_SEP},
           RspIn_ReadReceipt_Out) {
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// CompAck can arrive before this gateway observes the response/data half,
// either because the requester treats the first DataSepResp as RespSepData or
// because local/C2C queues reorder same-tick completion messages.
transition(REQ_ACTIVE, RspIn_CompAck_Out) {
  forwardFirstCompAckToC2CTx;
  markCompAckDone;
  popRspInQueue;
}

transition(REQ_ACTIVE, RspIn_CompAck_In) {
  forwardCompAckToHN;
  returnRspCredit;
  markCompAckDone;
  popC2CRxRspQueue;
}

// ACTIVE_WAIT_SEP: one half of a separated read has arrived; ports route
// completion vs more-data events based on TBE flags.
transition(ACTIVE_WAIT_SEP, DatIn_SepReadData_Done_Out, COMPACK_ACTIVE) {
  clearExpectingData;
  trackDatFlit;
  forwardC2CDatToLocal;
  returnDatCredit;
  checkTxnComplete;
  popC2CRxDatQueue;
}

transition(ACTIVE_WAIT_SEP, DatIn_SepReadData_Done_In, COMPACK_ACTIVE) {
  clearExpectingData;
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  checkTxnComplete;
  popDatInQueue;
}

transition(ACTIVE_WAIT_SEP, RspIn_SepReadResp_Done_Out, COMPACK_ACTIVE) {
  clearExpectingComp;
  forwardC2CRspToLocal;
  returnRspCredit;
  checkTxnComplete;
  popC2CRxRspQueue;
}

transition(ACTIVE_WAIT_SEP, RspIn_SepReadResp_Done_In, COMPACK_ACTIVE) {
  clearExpectingComp;
  consumeRspCredit;
  forwardLocalRspToC2C;
  checkTxnComplete;
  popRspInQueue;
}

// Multi-flit self-loop: additional data flits while still waiting for RespSepData
transition(ACTIVE_WAIT_SEP, DatIn_SepReadData_More_Out) {
  trackDatFlit;
  forwardC2CDatToLocal;
  returnDatCredit;
  popC2CRxDatQueue;
}

transition(ACTIVE_WAIT_SEP, DatIn_SepReadData_More_In) {
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  popDatInQueue;
}

// CompAck can race ahead of the remaining separated-read half; keep waiting in
// ACTIVE_WAIT_SEP until both response and data have been observed.
transition(ACTIVE_WAIT_SEP, RspIn_CompAck_Out) {
  forwardFirstCompAckToC2CTx;
  markCompAckDone;
  checkTxnComplete;
  popRspInQueue;
}

transition(ACTIVE_WAIT_SEP, RspIn_CompAck_In) {
  forwardCompAckToHN;
  returnRspCredit;
  markCompAckDone;
  checkTxnComplete;
  popC2CRxRspQueue;
}

// COMPACK_ACTIVE: response/data halves observed; remaining data flits and
// CompAck may still arrive in either order.

// Multi-flit: subsequent data flits while waiting for CompAck (outbound)
transition(COMPACK_ACTIVE, {DatIn_CompData_Out, DatIn_DataSepResp_Out}) {
  trackDatFlit;
  forwardC2CDatToLocal;
  returnDatCredit;
  checkTxnComplete;
  popC2CRxDatQueue;
}

// Multi-flit: subsequent data flits while waiting for CompAck (inbound)
transition(COMPACK_ACTIVE, {DatIn_CompData_In, DatIn_DataSepResp_In}) {
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  checkTxnComplete;
  popDatInQueue;
}

// CompAck from local RN via NoC (outbound: consume RSP credit, forward to C2C TX)
transition(COMPACK_ACTIVE, RspIn_CompAck_Out) {
  forwardFirstCompAckToC2CTx;
  markCompAckDone;
  checkTxnComplete;
  popRspInQueue;
}

// CompAck from remote RN via C2C RX (inbound: return RSP credit, forward to local HN)
transition(COMPACK_ACTIVE, RspIn_CompAck_In) {
  forwardCompAckToHN;
  returnRspCredit;
  markCompAckDone;
  checkTxnComplete;
  popC2CRxRspQueue;
}

// CompleteTxn: all data flits forwarded and CompAck done -> dealloc
transition(COMPACK_ACTIVE, CompleteTxn, I) {
  deallocateTBE;
  wakeUpStalled;
  popTriggerQueue;
}

// Inbound retry handshake. RetryAck and PCrdGrant may arrive in either
// order; tbe.retryState carries the state to resume after PCrdGrant.
transition({REQ_ACTIVE, WR_ACTIVE_DBID, COMPACK_DL_ACTIVE,
            COMP_ONLY_DL_ACTIVE,
            ATOMIC_ACTIVE, WR_PUSH_FWD_WAIT_DBID},
           RetryAckFromHN, RETRY_WAIT) {
  saveRetryState;
  markRetryPending;
  popRspInQueue;
}

transition({REQ_ACTIVE, WR_ACTIVE_DBID, COMPACK_DL_ACTIVE,
            COMP_ONLY_DL_ACTIVE,
            ATOMIC_ACTIVE, WR_PUSH_FWD_WAIT_DBID},
           EarlyPCrdGrantFromHN) {
  recordPCrdGrant;
  popRspInQueue;
}

transition({REQ_ACTIVE, WR_ACTIVE_DBID, COMPACK_DL_ACTIVE,
            COMP_ONLY_DL_ACTIVE,
            ATOMIC_ACTIVE, WR_PUSH_FWD_WAIT_DBID},
           RetryAckAfterPCrdGrantFromHN) {
  markRetryPending;
  reissueRequest;
  popRspInQueue;
}

transition(RETRY_WAIT, PCrdGrantRetryReqFromHN, REQ_ACTIVE) {
  reissueRequest;
  popRspInQueue;
}

transition(RETRY_WAIT, PCrdGrantRetryWriteFromHN, WR_ACTIVE_DBID) {
  reissueRequest;
  popRspInQueue;
}

transition(RETRY_WAIT, PCrdGrantRetryCompAckDatalessFromHN,
           COMPACK_DL_ACTIVE) {
  reissueRequest;
  popRspInQueue;
}

transition(RETRY_WAIT, PCrdGrantRetryCompOnlyDatalessFromHN,
           COMP_ONLY_DL_ACTIVE) {
  reissueRequest;
  popRspInQueue;
}

transition(RETRY_WAIT, PCrdGrantRetryAtomicFromHN, ATOMIC_ACTIVE) {
  reissueRequest;
  popRspInQueue;
}

transition(RETRY_WAIT, PCrdGrantRetryWritePushFromHN,
           WR_PUSH_FWD_WAIT_DBID) {
  reissueRequest;
  popRspInQueue;
}

transition(RETRY_WAIT, DatIn_RetryCompDataReq_In, COMPACK_ACTIVE) {
  clearExpectingData;
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  popDatInQueue;
}

transition(RETRY_WAIT, DatIn_RetryCompDataAtomic_In, I) {
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  clearRetryState;
  deallocateTBE;
  wakeUpStalled;
  popDatInQueue;
}

transition(RETRY_WAIT, RspIn_RetryCompWrite_In, WR_ACTIVE_DBID) {
  recordWriteComp;
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

transition(RETRY_WAIT, RspIn_RetryCompWritePush_In,
           WR_PUSH_FWD_WAIT_DBID) {
  recordWriteComp;
  consumeRspCredit;
  sendCompToC2C;
  popRspInQueue;
}

transition(RETRY_WAIT, RspIn_RetryCompAckDataless_In, COMPACK_ACTIVE) {
  markNoDataExpected;
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

transition(RETRY_WAIT, RspIn_StaleRetryCompDBIDResp_In) {
  popRspInQueue;
}

transition(RETRY_WAIT, RspIn_RetryCompOnlyDataless_In, I) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  clearRetryState;
  deallocateTBE;
  wakeUpStalled;
  popRspInQueue;
}

transition(RETRY_WAIT, RspIn_RetryCompAtomic_In, I) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  clearRetryState;
  deallocateTBE;
  wakeUpStalled;
  popRspInQueue;
}

transition({WR_ACTIVE_DBID, WR_WAIT_COMP, COMPACK_ACTIVE,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           PCrdGrantFromHN) {
  clearRetryState;
  popRspInQueue;
}

////////////////////////////////////////////////////////////////////////////
// Outbound write flow: local RN -> C2CG -> C2C -> remote HN
// Consume: REQ credit on send
// Return: RSP credit on C2C RX dequeue
////////////////////////////////////////////////////////////////////////////

// All write requests first wait for DBID or an evict/clean early Comp.
transition(I, {OutReq_WritePull, OutReq_WriteBackFull,
               OutReq_WriteEvictFull, OutReq_WriteCleanFull,
               OutReq_WriteCleanNoPush}, WR_ACTIVE_DBID) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

// Inbound write flow: remote RN -> peer C2CG -> C2C -> this C2CG -> local HN
// Return: REQ credit on C2C RX REQ dequeue
// Consume: RSP/DAT credit on send to C2C TX
transition(I, {InReq_Write, InReq_EvictWrite}, WR_ACTIVE_DBID) {
  allocateTBE;
  recordRemoteIDs_fromC2CReq;
  forwardC2CReqToLocal;
  returnReqCredit;
  popC2CRxReqQueue;
}

// DBIDResp for outbound write (from C2C RX RSP, return RSP credit)
transition(WR_ACTIVE_DBID, RspIn_DBIDResp_Out, WR_WAIT_COMP) {
  bindLocalDBIDFromC2CRsp;
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// CompDBIDResp for outbound write: DBID and Comp arrive together.
transition(WR_ACTIVE_DBID, RspIn_CompDBIDResp_Out, WR_WAIT_COMP) {
  recordWriteComp;
  bindLocalDBIDFromC2CRsp;
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// DBIDResp for inbound write (from local HN via NoC RSP, consume RSP credit)
transition(WR_ACTIVE_DBID, RspIn_DBIDResp_In, WR_WAIT_COMP) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

// CompDBIDResp for inbound write: DBID and Comp arrive together.
transition(WR_ACTIVE_DBID, RspIn_CompDBIDResp_In, WR_WAIT_COMP) {
  recordWriteComp;
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

// Comp can arrive before DBIDResp for any write type. Record it and wait for DBID.
transition(WR_ACTIVE_DBID, RspIn_Comp_Out) {
  recordWriteComp;
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

transition(WR_ACTIVE_DBID, RspIn_Comp_In) {
  recordWriteComp;
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

// WR_WAIT_COMP: outbound write data from local RN (NoC DAT -> C2C TX)
transition(WR_WAIT_COMP, {DatIn_CBWrData_Out, DatIn_NCBWrData_Out}) {
  trackDatFlit;
  consumeDatCredit;
  forwardDatToC2CTx;
  checkWriteTxnComplete;
  popDatInQueue;
}

// WR_WAIT_COMP: inbound write data from remote (C2C RX DAT -> local HN)
transition(WR_WAIT_COMP, {DatIn_CBWrData_In, DatIn_NCBWrData_In}) {
  trackDatFlit;
  forwardC2CWrDatToLocal;
  returnDatCredit;
  checkWriteTxnComplete;
  popC2CRxDatQueue;
}

// WR_WAIT_COMP: Comp from remote (outbound, C2C RX RSP -> local RN)
transition(WR_WAIT_COMP, RspIn_Comp_Out) {
  recordWriteComp;
  forwardC2CRspToLocal;
  returnRspCredit;
  checkWriteTxnComplete;
  popC2CRxRspQueue;
}

// WR_WAIT_COMP: Comp from local HN (inbound, NoC RSP -> C2C TX)
transition(WR_WAIT_COMP, RspIn_Comp_In) {
  recordWriteComp;
  consumeRspCredit;
  forwardLocalRspToC2C;
  checkWriteTxnComplete;
  popRspInQueue;
}

transition(WR_WAIT_COMP, CompleteTxn, I) {
  deallocateTBE;
  wakeUpStalled;
  popTriggerQueue;
}

////////////////////////////////////////////////////////////////////////////
// Outbound dataless: CleanUnique needs CompAck; Evict is Comp-only.
// Consume: REQ credit on send
// Return: RSP credit on C2C RX dequeue
////////////////////////////////////////////////////////////////////////////

transition(I, OutReq_CleanUnique, COMPACK_DL_ACTIVE) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

// Inbound CleanUnique: Comp is followed by requester CompAck.
transition(I, InReq_CleanUnique, COMPACK_DL_ACTIVE) {
  allocateTBE;
  recordRemoteIDs_fromC2CReq;
  forwardC2CReqToLocal;
  returnReqCredit;
  popC2CRxReqQueue;
}

// CleanUnique Comp from remote (outbound) -> forward to local, wait CompAck
transition(COMPACK_DL_ACTIVE, RspIn_Comp_Out, COMPACK_ACTIVE) {
  markNoDataExpected;
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// CleanUnique Comp from local HN (inbound) -> forward to C2C, wait CompAck
transition(COMPACK_DL_ACTIVE, RspIn_Comp_In, COMPACK_ACTIVE) {
  markNoDataExpected;
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

// Evict (outbound)
transition(I, OutReq_Evict, COMP_ONLY_DL_ACTIVE) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

// Inbound Evict
transition(I, InReq_Evict, COMP_ONLY_DL_ACTIVE) {
  allocateTBE;
  recordRemoteIDs_fromC2CReq;
  forwardC2CReqToLocal;
  returnReqCredit;
  popC2CRxReqQueue;
}

// Some requesters still emit CompAck for Evict-like Comp-only requests. The
// local HN does not need it, so just return the C2C RSP credit and wait for
// the terminal Comp.
transition(COMP_ONLY_DL_ACTIVE, RspIn_CompAck_In) {
  returnRspCredit;
  popC2CRxRspQueue;
}

// Evict Comp from remote (outbound) -> forward to local, done (no CompAck)
transition(COMP_ONLY_DL_ACTIVE, RspIn_Comp_Out, I) {
  forwardC2CRspToLocal;
  returnRspCredit;
  deallocateTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

// Evict Comp from local HN (inbound) -> forward to C2C, done
transition(COMP_ONLY_DL_ACTIVE, RspIn_Comp_In, I) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  deallocateTBE;
  wakeUpStalled;
  popRspInQueue;
}

////////////////////////////////////////////////////////////////////////////
// Outbound atomic flow
// Consume: REQ credit on send
// Return: RSP/DAT credit on C2C RX dequeue
////////////////////////////////////////////////////////////////////////////

transition(I, {OutReq_AtomicStore, OutReq_AtomicLoad},
           ATOMIC_ACTIVE) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

// Inbound atomic flow
transition(I, InReq_Atomic, ATOMIC_ACTIVE) {
  allocateTBE;
  recordRemoteIDs_fromC2CReq;
  forwardC2CReqToLocal;
  returnReqCredit;
  popC2CRxReqQueue;
}

// AtomicNoReturn: Comp from remote (outbound, C2C RX RSP)
transition(ATOMIC_ACTIVE, RspIn_Comp_Out, I) {
  forwardC2CRspToLocal;
  returnRspCredit;
  deallocateTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

// AtomicNoReturn: Comp from local HN (inbound, NoC RSP)
transition(ATOMIC_ACTIVE, RspIn_Comp_In, I) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  deallocateTBE;
  wakeUpStalled;
  popRspInQueue;
}

// AtomicReturn: CompData from remote (outbound, C2C RX DAT)
transition(ATOMIC_ACTIVE, DatIn_CompData_Out, I) {
  forwardC2CDatToLocal;
  returnDatCredit;
  deallocateTBE;
  wakeUpStalled;
  popC2CRxDatQueue;
}

// AtomicReturn: CompData from local HN (inbound, NoC DAT)
transition(ATOMIC_ACTIVE, DatIn_CompData_In, I) {
  consumeDatCredit;
  forwardLocalDatToC2C;
  deallocateTBE;
  wakeUpStalled;
  popDatInQueue;
}

// Atomic write data from local RN (outbound, NoC DAT -> C2C TX)
transition(ATOMIC_ACTIVE, {DatIn_CBWrData_Out, DatIn_NCBWrData_Out}) {
  consumeDatCredit;
  forwardDatToC2CTx;
  popDatInQueue;
}

// Atomic write data from remote (inbound, C2C RX DAT -> local HN)
transition(ATOMIC_ACTIVE, {DatIn_CBWrData_In, DatIn_NCBWrData_In}) {
  forwardC2CWrDatToLocal;
  returnDatCredit;
  popC2CRxDatQueue;
}

////////////////////////////////////////////////////////////////////////////
// Snoop flow: local HN -> this C2CG -> C2C -> peer C2CG -> remote RN
// Consume: SNP credit on send to C2C TX
// Return: RSP/DAT credit on C2C RX dequeue
// Uses snpTBEs (separate table, non-directional events)
////////////////////////////////////////////////////////////////////////////

transition(I, OutSnp_Forward, SNP_WAIT_RESP) {
  allocateSnpTBE;
  recordSnpIDs_fromSnp;
  recordOutboundSnpTargets;
  consumeSnpCredit;
  forwardSnpToC2CTx;
  popSnpInQueue;
}

transition(SNP_WAIT_RESP, RspIn_SnpResp_More_Out) {
  recordSnpRespNoData;
  forwardC2CSnpRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// Snoop response (no data) from remote (C2C RX RSP -> return RSP credit)
transition(SNP_WAIT_RESP, RspIn_SnpResp_Out, I) {
  recordSnpRespNoData;
  forwardC2CSnpRspToLocal;
  returnRspCredit;
  deallocateSnpTBE;
  popC2CRxRspQueue;
}

transition(SNP_WAIT_RESP, DatIn_SnpRespData_More_Out) {
  recordSnpRespDataFromC2C;
  forwardC2CSnpDatToLocal;
  returnDatCredit;
  popC2CRxDatQueue;
}

// Snoop response with data from remote (C2C RX DAT -> return DAT credit)
transition(SNP_WAIT_RESP, DatIn_SnpRespData_Out, I) {
  recordSnpRespDataFromC2C;
  forwardC2CSnpDatToLocal;
  returnDatCredit;
  deallocateSnpTBE;
  popC2CRxDatQueue;
}

// Inbound snoop from remote -> deliver to local caches, await response
// Return: SNP credit on C2C RX SNP dequeue
transition(I, InSnp_Deliver, SNP_WAIT_RESP) {
  allocateSnpTBE;
  recordInboundSnpIDs;
  recordInboundSnpTargets;
  forwardC2CSnpToLocal;
  returnSnpCredit;
  popC2CRxSnpQueue;
}

transition(SNP_WAIT_RESP, RspIn_SnpResp_More_In) {
  recordSnpRespNoData;
  consumeRspCredit;
  forwardLocalSnpRspToC2C;
  popRspInQueue;
}

// Inbound snoop response (no data) from local cache
transition(SNP_WAIT_RESP, RspIn_SnpResp_In, I) {
  recordSnpRespNoData;
  consumeRspCredit;
  forwardLocalSnpRspToC2C;
  deallocateSnpTBE;
  popRspInQueue;
}

transition(SNP_WAIT_RESP, DatIn_SnpRespData_More_In) {
  recordSnpRespDataFromLocal;
  consumeDatCredit;
  forwardLocalSnpDatToC2C;
  popDatInQueue;
}

// Inbound snoop response with data from local cache
transition(SNP_WAIT_RESP, DatIn_SnpRespData_In, I) {
  recordSnpRespDataFromLocal;
  consumeDatCredit;
  forwardLocalSnpDatToC2C;
  deallocateSnpTBE;
  popDatInQueue;
}

////////////////////////////////////////////////////////////////////////////
// DVM originator flow (Phase 4): local MN -> C2CG -> C2C -> remote MN
// MN sends SnpDvmOp P1/P2 to C2CG; C2CG reconstructs DvmOp and
// forwards using WritePull (req -> DBID -> NCBWrData -> Comp).
// Uses dvmTBEs (separate table, non-directional events, always outbound).
// Consume: REQ credit on DvmOp send, DAT credit on NCBWrData send
// Return: RSP credit on C2C RX dequeue
////////////////////////////////////////////////////////////////////////////

// P1 from local MN -> buffer in dvmTBE
transition(I, OutSnp_DvmP1, DVM_WAIT_P2) {
  allocateDvmTBE;
  recordDvmP1;
  popSnpInQueue;
}

// P2 from local MN -> reconstruct and send DvmOp across C2C
transition(DVM_WAIT_P2, OutSnp_DvmP2, DVM_WAIT_DBID) {
  consumeReqCredit;
  sendDvmReqToC2C;
  popSnpInQueue;
}

// DBIDResp from remote -> send NCBWrData
transition(DVM_WAIT_DBID, RspIn_DBIDResp, DVM_WAIT_COMP) {
  recordDvmPeerFromRsp;
  consumeDatCredit;
  sendDvmDataToC2C;
  returnRspCredit;
  popC2CRxRspQueue;
}

// CompDBIDResp from remote -> send data + complete immediately
transition(DVM_WAIT_DBID, RspIn_CompDBIDResp, I) {
  recordDvmPeerFromRsp;
  consumeDatCredit;
  sendDvmDataToC2C;
  sendSnpRespIToMN;
  returnRspCredit;
  deallocateDvmTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

// Comp from remote -> complete
transition(DVM_WAIT_COMP, RspIn_Comp, I) {
  sendSnpRespIToMN;
  returnRspCredit;
  deallocateDvmTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

////////////////////////////////////////////////////////////////////////////
// WritePush source-side flow (Phase 6: IHI0098A B4.6)
// Local RN sends write req + WriteData as separate messages.
// C2CG buffers write req, then combines with WriteData into
// WrReqDataS/L and sends as single C2C DAT message.
// Consume: REQ + DAT credit on combined send
// Return: RSP credit on Comp from remote
////////////////////////////////////////////////////////////////////////////

// Only WriteNoSnp/WriteUnique writes use the generic WritePush source flow.
transition(I, {OutReq_WriteNoSnpFull, OutReq_WriteNoSnpPtl,
         OutReq_WriteUniqueFull, OutReq_WriteUniquePtl},
           WR_PUSH_WAIT_DATA) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  popReqRdyQueue;
}

// WriteData arrives from local RN (outbound, NoC DAT) -> combine and send WrReqData
transition(WR_PUSH_WAIT_DATA, {DatIn_CBWrData_Out, DatIn_NCBWrData_Out},
           WR_PUSH_SENT) {
  consumeReqCredit;
  consumeDatCredit;
  combineAndSendWritePush;
  popDatInQueue;
}

// Comp from remote completes WritePush (outbound, C2C RX RSP)
transition(WR_PUSH_SENT, RspIn_Comp_Out, I) {
  forwardC2CRspToLocal;
  returnRspCredit;
  deallocateTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

////////////////////////////////////////////////////////////////////////////
// WritePush receiver-side flow (Phase 6)
// Peer C2CG receives WrReqDataS/L on C2C DAT, splits into separate
// write request (to local HN) + buffered data.
// After DBID from HN, sends buffered data as CBWrData.
// Return: DAT credit on WrReqData dequeue
////////////////////////////////////////////////////////////////////////////

// WrReqDataS/L from C2C -> split: forward REQ to local HN, buffer data
transition(I, DatIn_WrReqData, WR_PUSH_FWD_WAIT_DBID) {
  allocateTBE;
  splitWrReqDataToReq;
  returnDatCredit;
  popC2CRxDatQueue;
}

// DBID from local HN stays within the die: send buffered data to the local
// HN, but do not send any DBID-bearing message back across C2C.
transition(WR_PUSH_FWD_WAIT_DBID, RspIn_DBIDResp_In,
           WR_PUSH_FWD_WAIT_COMP) {
  sendBufferedWriteData;
  markWriteDataForwarded;
  checkWriteTxnComplete;
  popRspInQueue;
}

// CompDBIDResp means both DBID and Comp arrived locally. Keep the DBID part
// intra-die, send buffered data to the local HN, and forward only the Comp
// semantics back to the peer C2CG.
transition(WR_PUSH_FWD_WAIT_DBID, RspIn_CompDBIDResp_In,
           WR_PUSH_FWD_WAIT_COMP) {
  recordWriteComp;
  consumeRspCredit;
  sendCompToC2C;
  sendBufferedWriteData;
  markWriteDataForwarded;
  checkWriteTxnComplete;
  popRspInQueue;
}

// Comp can arrive before DBID. For immediate-write semantics, the C2C-visible
// completion is just Comp; the DBID handshake remains a die-local CHI detail.
transition(WR_PUSH_FWD_WAIT_DBID, RspIn_Comp_In) {
  recordWriteComp;
  consumeRspCredit;
  sendCompToC2C;
  popRspInQueue;
}

// Comp from local HN (inbound receiver, NoC RSP) completes after buffered
// data has been sent.
transition(WR_PUSH_FWD_WAIT_COMP, RspIn_Comp_In) {
  recordWriteComp;
  consumeRspCredit;
  sendCompToC2C;
  checkWriteTxnComplete;
  popRspInQueue;
}

transition(WR_PUSH_FWD_WAIT_COMP, CompleteTxn, I) {
  deallocateTBE;
  wakeUpStalled;
  popTriggerQueue;
}

////////////////////////////////////////////////////////////////////////////
// Retry/credit trigger queue (valid in all states)
////////////////////////////////////////////////////////////////////////////

transition({I, REQ_ACTIVE, ACTIVE_WAIT_SEP,
            WR_ACTIVE_DBID, WR_WAIT_COMP,
            COMPACK_ACTIVE, COMPACK_DL_ACTIVE,
            COMP_ONLY_DL_ACTIVE, ATOMIC_ACTIVE,
            RETRY_WAIT,
            SNP_WAIT_RESP,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           SendRetryAck) {
  sendRetryAck;
  popRetryTriggerQueue;
}

transition({I, REQ_ACTIVE, ACTIVE_WAIT_SEP,
            WR_ACTIVE_DBID, WR_WAIT_COMP,
            COMPACK_ACTIVE, COMPACK_DL_ACTIVE,
            COMP_ONLY_DL_ACTIVE, ATOMIC_ACTIVE,
            RETRY_WAIT,
            SNP_WAIT_RESP,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           SendPCrdGrant) {
  sendPCrdGrant;
  popRetryTriggerQueue;
}

////////////////////////////////////////////////////////////////////////////
// Stall transitions for busy addresses
////////////////////////////////////////////////////////////////////////////

// Stall snoops on addresses with pending snoop forwarding
transition(SNP_WAIT_RESP, OutSnp_Forward) {
  stallSnpQueue;
}

transition({REQ_ACTIVE, ACTIVE_WAIT_SEP,
            WR_ACTIVE_DBID, WR_WAIT_COMP,
            COMPACK_ACTIVE, COMPACK_DL_ACTIVE,
            COMP_ONLY_DL_ACTIVE, ATOMIC_ACTIVE,
            RETRY_WAIT,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           {OutReq_ReadShared, OutReq_ReadUnique, OutReq_ReadOnce,
            OutReq_ReadNoSnp, OutReq_ReadNotSharedDirty,
            OutReq_CleanUnique, OutReq_Evict,
            OutReq_WriteUniqueFull, OutReq_WriteUniquePtl,
            OutReq_WriteBackFull, OutReq_WriteCleanFull,
            OutReq_WriteEvictFull, OutReq_WriteNoSnpFull,
            OutReq_WriteNoSnpPtl,
            OutReq_WritePull, OutReq_WriteCleanNoPush,
            OutReq_AtomicStore, OutReq_AtomicLoad}) {
  stallRequestQueue;
}

transition({REQ_ACTIVE, ACTIVE_WAIT_SEP,
            WR_ACTIVE_DBID, WR_WAIT_COMP,
            COMPACK_ACTIVE, COMPACK_DL_ACTIVE,
            COMP_ONLY_DL_ACTIVE, ATOMIC_ACTIVE,
            RETRY_WAIT,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           {InReq_Read, InReq_Write, InReq_EvictWrite,
            InReq_CleanUnique, InReq_Evict, InReq_Atomic}) {
  stallC2CRxReqQueue;
}
