// CHI C2C Gateway transition table
// HR-4: 8 outbound/inbound state pairs merged into bidirectional states.
// Direction tracked via tbe.isOutbound + _Out/_In event split at port handlers.
//
// State count: 26 (down from 34, -8 pairs merged)
//
// Credit rules (Decision D5):
//   Consume: when message is enqueued to C2C TX buffer
//   Return: when message is dequeued from C2C RX buffer
//
// _Out events: arrive from C2C RX (outbound TBE) → return C2C credits
// _In  events: arrive from local NoC (inbound TBE) → consume C2C credits
//
// Consume actions are placed BEFORE the forwarding action.
// Return actions are placed BEFORE the pop action.

// All 26 active states (for wildcard transition lists)
// I, REQ_ACTIVE, ACTIVE_WAIT_DAT, ACTIVE_WAIT_COMP,
// WR_ACTIVE_DBID, EVWR_WAIT_DBID, WR_WAIT_COMP, WR_FWD_WAIT_DATA,
// COMPACK_ACTIVE, DL_ACTIVE, EV_ACTIVE, ATOMIC_ACTIVE,
// REQ_RETRY_WAIT, WR_RETRY_WAIT, DL_RETRY_WAIT, EV_RETRY_WAIT,
// ATOMIC_RETRY_WAIT, WR_PUSH_RETRY_WAIT,
// SNP_WAIT_RESP, INB_SNP_WAIT_RESP,
// DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
// WR_PUSH_WAIT_DATA, WR_PUSH_SENT, WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP

////////////////////////////////////////////////////////////////////////////
// TBE allocation from NoC requests
////////////////////////////////////////////////////////////////////////////

transition({I, REQ_ACTIVE, ACTIVE_WAIT_DAT, ACTIVE_WAIT_COMP,
            WR_ACTIVE_DBID, EVWR_WAIT_DBID, WR_WAIT_COMP, WR_FWD_WAIT_DATA,
            COMPACK_ACTIVE, DL_ACTIVE, EV_ACTIVE, ATOMIC_ACTIVE,
            REQ_RETRY_WAIT, WR_RETRY_WAIT, DL_RETRY_WAIT, EV_RETRY_WAIT,
            ATOMIC_RETRY_WAIT, WR_PUSH_RETRY_WAIT,
            SNP_WAIT_RESP, INB_SNP_WAIT_RESP,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           CheckAllocTBE) {
  checkAllocateTBE;
}

transition({I, REQ_ACTIVE, ACTIVE_WAIT_DAT, ACTIVE_WAIT_COMP,
            WR_ACTIVE_DBID, EVWR_WAIT_DBID, WR_WAIT_COMP, WR_FWD_WAIT_DATA,
            COMPACK_ACTIVE, DL_ACTIVE, EV_ACTIVE, ATOMIC_ACTIVE,
            REQ_RETRY_WAIT, WR_RETRY_WAIT, DL_RETRY_WAIT, EV_RETRY_WAIT,
            ATOMIC_RETRY_WAIT, WR_PUSH_RETRY_WAIT,
            SNP_WAIT_RESP, INB_SNP_WAIT_RESP,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           CheckAllocTBE_WithCredit) {
  checkAllocateTBE_withCredit;
}

////////////////////////////////////////////////////////////////////////////
// Outbound read flow: local RN -> C2CG -> C2C -> remote HN
// Consume: REQ credit on send
// Return: RSP/DAT credit on C2C RX dequeue
////////////////////////////////////////////////////////////////////////////

transition(I, {OutReq_ReadShared, OutReq_ReadUnique, OutReq_ReadOnce,
               OutReq_ReadNoSnp, OutReq_ReadNotSharedDirty},
           REQ_ACTIVE) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  setExpectingData;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

// Inbound read flow: remote RN -> peer C2CG -> C2C -> this C2CG -> local HN
// Return: REQ credit on C2C RX REQ dequeue
// Consume: RSP/DAT credit on send to C2C TX
transition(I, InReq_Read, REQ_ACTIVE) {
  allocateTBE;
  recordRemoteIDs_fromC2CReq;
  setExpectingData;
  forwardC2CReqToLocal;
  returnReqCredit;
  popC2CRxReqQueue;
}

// CompData from remote HN via C2C RX (outbound TBE)
transition(REQ_ACTIVE, DatIn_CompData_Out, COMPACK_ACTIVE) {
  trackDatFlit;
  forwardC2CDatToLocal;
  returnDatCredit;
  popC2CRxDatQueue;
}

// CompData from local HN via NoC DAT (inbound TBE)
transition(REQ_ACTIVE, DatIn_CompData_In, COMPACK_ACTIVE) {
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  popDatInQueue;
}

// Separated: DataSepResp first from C2C RX (outbound TBE)
transition(REQ_ACTIVE, DatIn_DataSepResp_Out, ACTIVE_WAIT_COMP) {
  trackDatFlit;
  forwardC2CDatToLocal;
  returnDatCredit;
  popC2CRxDatQueue;
}

// Separated: DataSepResp first from local HN (inbound TBE)
transition(REQ_ACTIVE, DatIn_DataSepResp_In, ACTIVE_WAIT_COMP) {
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  popDatInQueue;
}

// Separated: RespSepData first from C2C RX (outbound TBE)
transition(REQ_ACTIVE, RspIn_RespSepData_Out, ACTIVE_WAIT_DAT) {
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// Separated: RespSepData first from local HN (inbound TBE)
transition(REQ_ACTIVE, RspIn_RespSepData_In, ACTIVE_WAIT_DAT) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

// Informational Comp for outbound CompData reads (no data, just return RSP credit)
transition(REQ_ACTIVE, RspIn_Comp_Out) {
  returnRspCredit;
  popC2CRxRspQueue;
}

// Informational Comp for inbound CompData reads from local HN
// (consumed by local HN protocol, forwarded to C2C for remote RN)
transition(REQ_ACTIVE, RspIn_Comp_In) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

// ReadReceipt: outbound only (from C2C RX, forward to local RN)
// HR-6a: ReadReceipt must be forwarded to local RN
transition({REQ_ACTIVE, ACTIVE_WAIT_DAT, ACTIVE_WAIT_COMP},
           RspIn_ReadReceipt_Out) {
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// ACTIVE_WAIT_DAT: RespSepData already received, waiting for DataSepResp

transition(ACTIVE_WAIT_DAT, DatIn_DataSepResp_Out, COMPACK_ACTIVE) {
  trackDatFlit;
  forwardC2CDatToLocal;
  returnDatCredit;
  popC2CRxDatQueue;
}

transition(ACTIVE_WAIT_DAT, DatIn_DataSepResp_In, COMPACK_ACTIVE) {
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  popDatInQueue;
}

// ACTIVE_WAIT_COMP: DataSepResp already received, waiting for RespSepData

transition(ACTIVE_WAIT_COMP, RspIn_RespSepData_Out, COMPACK_ACTIVE) {
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

transition(ACTIVE_WAIT_COMP, RspIn_RespSepData_In, COMPACK_ACTIVE) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

// Multi-flit self-loop: additional data flits while waiting for RespSepData
transition(ACTIVE_WAIT_COMP, {DatIn_CompData_Out, DatIn_DataSepResp_Out}) {
  trackDatFlit;
  forwardC2CDatToLocal;
  returnDatCredit;
  popC2CRxDatQueue;
}

transition(ACTIVE_WAIT_COMP, {DatIn_CompData_In, DatIn_DataSepResp_In}) {
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  popDatInQueue;
}

// COMPACK_ACTIVE: all data forwarded, waiting for CompAck

// Multi-flit: subsequent data flits while waiting for CompAck (outbound)
transition(COMPACK_ACTIVE, {DatIn_CompData_Out, DatIn_DataSepResp_Out}) {
  trackDatFlit;
  forwardC2CDatToLocal;
  returnDatCredit;
  checkTxnComplete;
  popC2CRxDatQueue;
}

// Multi-flit: subsequent data flits while waiting for CompAck (inbound)
transition(COMPACK_ACTIVE, {DatIn_CompData_In, DatIn_DataSepResp_In}) {
  trackDatFlit;
  consumeDatCredit;
  forwardLocalDatToC2C;
  checkTxnComplete;
  popDatInQueue;
}

// CompAck from local RN via NoC (outbound: consume RSP credit, forward to C2C TX)
transition(COMPACK_ACTIVE, RspIn_CompAck_Out) {
  consumeRspCredit;
  forwardRspToC2CTx;
  markCompAckDone;
  checkTxnComplete;
  popRspInQueue;
}

// CompAck from remote RN via C2C RX (inbound: return RSP credit, forward to local HN)
transition(COMPACK_ACTIVE, RspIn_CompAck_In) {
  forwardCompAckToHN;
  returnRspCredit;
  markCompAckDone;
  checkTxnComplete;
  popC2CRxRspQueue;
}

// CompleteTxn: all data flits forwarded and CompAck done -> dealloc
transition(COMPACK_ACTIVE, CompleteTxn, I) {
  deallocateTBE;
  wakeUpStalled;
  popTriggerQueue;
}

// Inbound read retry: local HN sent RetryAck
transition(REQ_ACTIVE, RetryAckFromHN, REQ_RETRY_WAIT) {
  recordPCrdType;
  popRspInQueue;
}

transition(REQ_RETRY_WAIT, PCrdGrantFromHN, REQ_ACTIVE) {
  reissueRequest;
  popRspInQueue;
}

////////////////////////////////////////////////////////////////////////////
// Outbound write flow: local RN -> C2CG -> C2C -> remote HN
// Consume: REQ credit on send
// Return: RSP credit on C2C RX dequeue
////////////////////////////////////////////////////////////////////////////

// Non-evict writes use WritePull path (writepush disabled fallback)
transition(I, OutReq_WritePull, WR_ACTIVE_DBID) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

// Evict/clean writes: WriteEvictFull always pull, WriteCleanFull pull fallback
// These can receive Comp directly (no DBID) from HN
transition(I, {OutReq_WriteEvictFull, OutReq_EvictWritePull},
           EVWR_WAIT_DBID) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

// Inbound write flow: remote RN -> peer C2CG -> C2C -> this C2CG -> local HN
// Return: REQ credit on C2C RX REQ dequeue
// Consume: RSP/DAT credit on send to C2C TX
transition(I, InReq_Write, WR_ACTIVE_DBID) {
  allocateTBE;
  recordRemoteIDs_fromC2CReq;
  forwardC2CReqToLocal;
  returnReqCredit;
  popC2CRxReqQueue;
}

// DBIDResp for outbound write (from C2C RX RSP, return RSP credit)
transition(WR_ACTIVE_DBID, {RspIn_CompDBIDResp_Out, RspIn_DBIDResp_Out},
           WR_WAIT_COMP) {
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// DBIDResp for inbound write (from local HN via NoC RSP, consume RSP credit)
transition(WR_ACTIVE_DBID, {RspIn_CompDBIDResp_In, RspIn_DBIDResp_In},
           WR_FWD_WAIT_DATA) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

// WriteEvictFull early Comp from local HN (inbound path: no DBIDResp)
transition(WR_ACTIVE_DBID, RspIn_Comp_In, I) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  deallocateTBE;
  wakeUpStalled;
  popRspInQueue;
}

// Inbound write retry
transition(WR_ACTIVE_DBID, RetryAckFromHN, WR_RETRY_WAIT) {
  recordPCrdType;
  popRspInQueue;
}

transition(WR_RETRY_WAIT, PCrdGrantFromHN, WR_ACTIVE_DBID) {
  reissueRequest;
  popRspInQueue;
}

// EVWR_WAIT_DBID: evict/clean write DBIDResp (outbound, C2C RX RSP)
transition(EVWR_WAIT_DBID, {RspIn_CompDBIDResp_Out, RspIn_DBIDResp_Out},
           WR_WAIT_COMP) {
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// EVWR_WAIT_DBID: early Comp from remote (outbound, evict/clean write only)
transition(EVWR_WAIT_DBID, RspIn_Comp_Out, I) {
  forwardC2CRspToLocal;
  returnRspCredit;
  deallocateTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

// WR_WAIT_COMP: write data from local RN (outbound, NoC DAT -> C2C TX)
transition(WR_WAIT_COMP, {DatIn_CBWrData_Out, DatIn_NCBWrData_Out}) {
  consumeDatCredit;
  forwardDatToC2CTx;
  popDatInQueue;
}

// WR_WAIT_COMP: Comp from remote (outbound, C2C RX RSP -> local RN)
transition(WR_WAIT_COMP, RspIn_Comp_Out, I) {
  forwardC2CRspToLocal;
  returnRspCredit;
  deallocateTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

// WR_FWD_WAIT_DATA: write data from remote (inbound, C2C RX DAT -> local HN)
transition(WR_FWD_WAIT_DATA, {DatIn_CBWrData_In, DatIn_NCBWrData_In}) {
  forwardC2CDatToLocal;
  returnDatCredit;
  popC2CRxDatQueue;
}

// WR_FWD_WAIT_DATA: Comp from local HN (inbound, NoC RSP -> C2C TX)
transition(WR_FWD_WAIT_DATA, RspIn_Comp_In, I) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  deallocateTBE;
  wakeUpStalled;
  popRspInQueue;
}

////////////////////////////////////////////////////////////////////////////
// Outbound dataless: CleanUnique (needs CompAck) and Evict (no CompAck)
// Consume: REQ credit on send
// Return: RSP credit on C2C RX dequeue
////////////////////////////////////////////////////////////////////////////

transition(I, OutReq_CleanUnique, DL_ACTIVE) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

// Inbound dataless: CleanUnique and Evict
transition(I, InReq_Dataless, DL_ACTIVE) {
  allocateTBE;
  recordRemoteIDs_fromC2CReq;
  forwardC2CReqToLocal;
  returnReqCredit;
  popC2CRxReqQueue;
}

// CleanUnique Comp from remote (outbound) -> forward to local, wait CompAck
transition(DL_ACTIVE, RspIn_Comp_Out, COMPACK_ACTIVE) {
  markNoDataExpected;
  forwardC2CRspToLocal;
  returnRspCredit;
  popC2CRxRspQueue;
}

// CleanUnique Comp from local HN (inbound) -> forward to C2C, wait CompAck
transition(DL_ACTIVE, RspIn_Comp_In, COMPACK_ACTIVE) {
  markNoDataExpected;
  consumeRspCredit;
  forwardLocalRspToC2C;
  popRspInQueue;
}

transition(DL_ACTIVE, RetryAckFromHN, DL_RETRY_WAIT) {
  recordPCrdType;
  popRspInQueue;
}

transition(DL_RETRY_WAIT, PCrdGrantFromHN, DL_ACTIVE) {
  reissueRequest;
  popRspInQueue;
}

// Evict (outbound)
transition(I, OutReq_Evict, EV_ACTIVE) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

// Inbound Evict
transition(I, InReq_Evict, EV_ACTIVE) {
  allocateTBE;
  recordRemoteIDs_fromC2CReq;
  forwardC2CReqToLocal;
  returnReqCredit;
  popC2CRxReqQueue;
}

// Evict Comp from remote (outbound) -> forward to local, done (no CompAck)
transition(EV_ACTIVE, RspIn_Comp_Out, I) {
  forwardC2CRspToLocal;
  returnRspCredit;
  deallocateTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

// Evict Comp from local HN (inbound) -> forward to C2C, done
transition(EV_ACTIVE, RspIn_Comp_In, I) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  deallocateTBE;
  wakeUpStalled;
  popRspInQueue;
}

transition(EV_ACTIVE, RetryAckFromHN, EV_RETRY_WAIT) {
  recordPCrdType;
  popRspInQueue;
}

transition(EV_RETRY_WAIT, PCrdGrantFromHN, EV_ACTIVE) {
  reissueRequest;
  popRspInQueue;
}

////////////////////////////////////////////////////////////////////////////
// Outbound atomic flow
// Consume: REQ credit on send
// Return: RSP/DAT credit on C2C RX dequeue
////////////////////////////////////////////////////////////////////////////

transition(I, {OutReq_AtomicStore, OutReq_AtomicLoad},
           ATOMIC_ACTIVE) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  consumeReqCredit;
  forwardReqToC2CTx;
  popReqRdyQueue;
}

// Inbound atomic flow
transition(I, InReq_Atomic, ATOMIC_ACTIVE) {
  allocateTBE;
  recordRemoteIDs_fromC2CReq;
  forwardC2CReqToLocal;
  returnReqCredit;
  popC2CRxReqQueue;
}

// AtomicNoReturn: Comp from remote (outbound, C2C RX RSP)
transition(ATOMIC_ACTIVE, RspIn_Comp_Out, I) {
  forwardC2CRspToLocal;
  returnRspCredit;
  deallocateTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

// AtomicNoReturn: Comp from local HN (inbound, NoC RSP)
transition(ATOMIC_ACTIVE, RspIn_Comp_In, I) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  deallocateTBE;
  wakeUpStalled;
  popRspInQueue;
}

// AtomicReturn: CompData from remote (outbound, C2C RX DAT)
transition(ATOMIC_ACTIVE, DatIn_CompData_Out, I) {
  forwardC2CDatToLocal;
  returnDatCredit;
  deallocateTBE;
  wakeUpStalled;
  popC2CRxDatQueue;
}

// AtomicReturn: CompData from local HN (inbound, NoC DAT)
transition(ATOMIC_ACTIVE, DatIn_CompData_In, I) {
  consumeDatCredit;
  forwardLocalDatToC2C;
  deallocateTBE;
  wakeUpStalled;
  popDatInQueue;
}

// Atomic write data from local RN (outbound, NoC DAT -> C2C TX)
transition(ATOMIC_ACTIVE, {DatIn_CBWrData_Out, DatIn_NCBWrData_Out}) {
  consumeDatCredit;
  forwardDatToC2CTx;
  popDatInQueue;
}

// Atomic write data from remote (inbound, C2C RX DAT -> local HN)
transition(ATOMIC_ACTIVE, {DatIn_CBWrData_In, DatIn_NCBWrData_In}) {
  forwardC2CDatToLocal;
  returnDatCredit;
  popC2CRxDatQueue;
}

transition(ATOMIC_ACTIVE, RetryAckFromHN, ATOMIC_RETRY_WAIT) {
  recordPCrdType;
  popRspInQueue;
}

transition(ATOMIC_RETRY_WAIT, PCrdGrantFromHN, ATOMIC_ACTIVE) {
  reissueRequest;
  popRspInQueue;
}

////////////////////////////////////////////////////////////////////////////
// Snoop flow: local HN -> this C2CG -> C2C -> peer C2CG -> remote RN
// Consume: SNP credit on send to C2C TX
// Return: RSP/DAT credit on C2C RX dequeue
// Uses snpTBEs (separate table, non-directional events)
////////////////////////////////////////////////////////////////////////////

transition(I, OutSnp_Forward, SNP_WAIT_RESP) {
  allocateSnpTBE;
  recordSnpIDs_fromSnp;
  consumeSnpCredit;
  forwardSnpToC2CTx;
  popSnpInQueue;
}

// Snoop response (no data) from remote (C2C RX RSP -> return RSP credit)
transition(SNP_WAIT_RESP, RspIn_SnpResp, I) {
  forwardC2CSnpRspToLocal;
  returnRspCredit;
  deallocateSnpTBE;
  popC2CRxRspQueue;
}

// Snoop response with data from remote (C2C RX DAT -> return DAT credit)
transition(SNP_WAIT_RESP, DatIn_SnpRespData, I) {
  forwardC2CSnpDatToLocal;
  returnDatCredit;
  deallocateSnpTBE;
  popC2CRxDatQueue;
}

// Inbound snoop from remote -> deliver to local caches, await response
// Return: SNP credit on C2C RX SNP dequeue
transition(I, InSnp_Deliver, INB_SNP_WAIT_RESP) {
  allocateSnpTBE;
  recordInboundSnpIDs;
  forwardC2CSnpToLocal;
  returnSnpCredit;
  popC2CRxSnpQueue;
}

// Inbound snoop response (no data) from local cache
transition(INB_SNP_WAIT_RESP, RspIn_SnpResp, I) {
  consumeRspCredit;
  forwardLocalSnpRspToC2C;
  deallocateSnpTBE;
  popRspInQueue;
}

// Inbound snoop response with data from local cache
transition(INB_SNP_WAIT_RESP, DatIn_SnpRespData, I) {
  consumeDatCredit;
  forwardLocalSnpDatToC2C;
  deallocateSnpTBE;
  popDatInQueue;
}

////////////////////////////////////////////////////////////////////////////
// DVM originator flow (Phase 4): local MN -> C2CG -> C2C -> remote MN
// MN sends SnpDvmOp P1/P2 to C2CG; C2CG reconstructs DvmOp and
// forwards using WritePull (req -> DBID -> NCBWrData -> Comp).
// Uses dvmTBEs (separate table, non-directional events, always outbound).
// Consume: REQ credit on DvmOp send, DAT credit on NCBWrData send
// Return: RSP credit on C2C RX dequeue
////////////////////////////////////////////////////////////////////////////

// P1 from local MN -> buffer in dvmTBE
transition(I, OutSnp_DvmP1, DVM_WAIT_P2) {
  allocateDvmTBE;
  recordDvmP1;
  popSnpInQueue;
}

// P2 from local MN -> reconstruct and send DvmOp across C2C
transition(DVM_WAIT_P2, OutSnp_DvmP2, DVM_WAIT_DBID) {
  consumeReqCredit;
  sendDvmReqToC2C;
  popSnpInQueue;
}

// DBIDResp from remote -> send NCBWrData
transition(DVM_WAIT_DBID, RspIn_DBIDResp, DVM_WAIT_COMP) {
  recordDvmPeerFromRsp;
  consumeDatCredit;
  sendDvmDataToC2C;
  returnRspCredit;
  popC2CRxRspQueue;
}

// CompDBIDResp from remote -> send data + complete immediately
transition(DVM_WAIT_DBID, RspIn_CompDBIDResp, I) {
  recordDvmPeerFromRsp;
  consumeDatCredit;
  sendDvmDataToC2C;
  sendSnpRespIToMN;
  returnRspCredit;
  deallocateDvmTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

// Comp from remote -> complete
transition(DVM_WAIT_COMP, RspIn_Comp, I) {
  sendSnpRespIToMN;
  returnRspCredit;
  deallocateDvmTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

////////////////////////////////////////////////////////////////////////////
// WritePush source-side flow (Phase 6: IHI0098A B4.6)
// Local RN sends write req + WriteData as separate messages.
// C2CG buffers write req, then combines with WriteData into
// WrReqDataS/L and sends as single C2C DAT message.
// Consume: REQ + DAT credit on combined send
// Return: RSP credit on Comp from remote
////////////////////////////////////////////////////////////////////////////

// Outbound write eligible for WritePush: buffer request, wait for data
transition(I, {OutReq_WriteNoSnpFull, OutReq_WriteNoSnpPtl,
               OutReq_WriteUniqueFull, OutReq_WriteUniquePtl,
               OutReq_WriteBackFull, OutReq_WriteCleanFull},
           WR_PUSH_WAIT_DATA) {
  allocateTBE;
  setOutbound;
  recordLocalIDs_fromReq;
  popReqRdyQueue;
}

// WriteData arrives from local RN (outbound, NoC DAT) -> combine and send WrReqData
transition(WR_PUSH_WAIT_DATA, {DatIn_CBWrData_Out, DatIn_NCBWrData_Out},
           WR_PUSH_SENT) {
  consumeReqCredit;
  consumeDatCredit;
  combineAndSendWritePush;
  popDatInQueue;
}

// Comp from remote completes WritePush (outbound, C2C RX RSP)
transition(WR_PUSH_SENT, RspIn_Comp_Out, I) {
  forwardC2CRspToLocal;
  returnRspCredit;
  deallocateTBE;
  wakeUpStalled;
  popC2CRxRspQueue;
}

////////////////////////////////////////////////////////////////////////////
// WritePush receiver-side flow (Phase 6)
// Peer C2CG receives WrReqDataS/L on C2C DAT, splits into separate
// write request (to local HN) + buffered data.
// After DBID from HN, sends buffered data as CBWrData.
// Return: DAT credit on WrReqData dequeue
////////////////////////////////////////////////////////////////////////////

// WrReqDataS/L from C2C -> split: forward REQ to local HN, buffer data
transition(I, DatIn_WrReqData, WR_PUSH_FWD_WAIT_DBID) {
  allocateTBE;
  splitWrReqDataToReq;
  returnDatCredit;
  popC2CRxDatQueue;
}

// DBID from local HN (inbound receiver, NoC RSP)
transition(WR_PUSH_FWD_WAIT_DBID, {RspIn_CompDBIDResp_In, RspIn_DBIDResp_In},
           WR_PUSH_FWD_WAIT_COMP) {
  sendBufferedWriteData;
  popRspInQueue;
}

// Retry for WR_PUSH receiver (local HN retries via NoC RSP)
transition(WR_PUSH_FWD_WAIT_DBID, RetryAckFromHN, WR_PUSH_RETRY_WAIT) {
  recordPCrdType;
  popRspInQueue;
}

transition(WR_PUSH_RETRY_WAIT, PCrdGrantFromHN, WR_PUSH_FWD_WAIT_DBID) {
  reissueRequest;
  popRspInQueue;
}

// Comp from local HN (inbound receiver, NoC RSP) -> forward to remote peer, done
transition(WR_PUSH_FWD_WAIT_COMP, RspIn_Comp_In, I) {
  consumeRspCredit;
  forwardLocalRspToC2C;
  deallocateTBE;
  wakeUpStalled;
  popRspInQueue;
}

////////////////////////////////////////////////////////////////////////////
// Retry/credit trigger queue (valid in all states)
////////////////////////////////////////////////////////////////////////////

transition({I, REQ_ACTIVE, ACTIVE_WAIT_DAT, ACTIVE_WAIT_COMP,
            WR_ACTIVE_DBID, EVWR_WAIT_DBID, WR_WAIT_COMP, WR_FWD_WAIT_DATA,
            COMPACK_ACTIVE, DL_ACTIVE, EV_ACTIVE, ATOMIC_ACTIVE,
            REQ_RETRY_WAIT, WR_RETRY_WAIT, DL_RETRY_WAIT, EV_RETRY_WAIT,
            ATOMIC_RETRY_WAIT, WR_PUSH_RETRY_WAIT,
            SNP_WAIT_RESP, INB_SNP_WAIT_RESP,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           SendRetryAck) {
  sendRetryAck;
  popRetryTriggerQueue;
}

transition({I, REQ_ACTIVE, ACTIVE_WAIT_DAT, ACTIVE_WAIT_COMP,
            WR_ACTIVE_DBID, EVWR_WAIT_DBID, WR_WAIT_COMP, WR_FWD_WAIT_DATA,
            COMPACK_ACTIVE, DL_ACTIVE, EV_ACTIVE, ATOMIC_ACTIVE,
            REQ_RETRY_WAIT, WR_RETRY_WAIT, DL_RETRY_WAIT, EV_RETRY_WAIT,
            ATOMIC_RETRY_WAIT, WR_PUSH_RETRY_WAIT,
            SNP_WAIT_RESP, INB_SNP_WAIT_RESP,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           SendPCrdGrant) {
  sendPCrdGrant;
  popRetryTriggerQueue;
}

////////////////////////////////////////////////////////////////////////////
// Stall transitions for busy addresses
////////////////////////////////////////////////////////////////////////////

// Stall snoops on addresses with pending snoop forwarding
transition(SNP_WAIT_RESP, OutSnp_Forward) {
  stallSnpQueue;
}

transition({REQ_ACTIVE, ACTIVE_WAIT_DAT, ACTIVE_WAIT_COMP,
            WR_ACTIVE_DBID, EVWR_WAIT_DBID, WR_WAIT_COMP, WR_FWD_WAIT_DATA,
            COMPACK_ACTIVE, DL_ACTIVE, EV_ACTIVE, ATOMIC_ACTIVE,
            REQ_RETRY_WAIT, WR_RETRY_WAIT, DL_RETRY_WAIT, EV_RETRY_WAIT,
            ATOMIC_RETRY_WAIT, WR_PUSH_RETRY_WAIT,
            DVM_WAIT_P2, DVM_WAIT_DBID, DVM_WAIT_COMP,
            WR_PUSH_WAIT_DATA, WR_PUSH_SENT,
            WR_PUSH_FWD_WAIT_DBID, WR_PUSH_FWD_WAIT_COMP},
           {OutReq_ReadShared, OutReq_ReadUnique, OutReq_ReadOnce,
            OutReq_ReadNoSnp, OutReq_ReadNotSharedDirty,
            OutReq_CleanUnique, OutReq_Evict,
            OutReq_WriteUniqueFull, OutReq_WriteUniquePtl,
            OutReq_WriteBackFull, OutReq_WriteCleanFull,
            OutReq_WriteEvictFull, OutReq_WriteNoSnpFull,
            OutReq_WriteNoSnpPtl,
            OutReq_WritePull, OutReq_EvictWritePull,
            OutReq_AtomicStore, OutReq_AtomicLoad}) {
  stallRequestQueue;
}
