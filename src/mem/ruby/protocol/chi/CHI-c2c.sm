// CHI C2C Gateway Controller
// Implements the protocol-layer gateway per IHI0098A (AMBA CHI C2C)
// Phase 6: WritePush combining (WrReqDataS/L)

machine(MachineType:CHI_C2C, "CHI C2C Gateway Controller") :

  // Latency parameters
  Cycles request_latency := 1;
  Cycles response_latency := 1;
  Cycles snoop_latency := 1;
  Cycles data_latency := 1;
  Cycles stall_recycle_lat := 1;

  // TBE sizing
  int number_of_snoop_TBEs;
  int number_of_dvm_TBEs := 4;

  // DVM TxnID offset to avoid collision with remote MN address space
  int dvm_txnid_offset := 65536;

  // Feature support parameters (Phase 5: interface management)
  bool timed_init := "false";
  bool dvm_support := "true";
  bool snoop_support := "true";
  bool atomic_support := "true";
  bool writepush_enabled := "true";
  bool readmerge_enabled := "false";

  // Data channel width
  int data_channel_size;

  // Credit parameters (Phase 3: pre-configured, per Decision D8)
  int num_resource_planes := 1;
  int init_req_credits_per_rp := 16;
  int init_req_credits_shared := 32;
  int init_rsp_credits := 32;
  int init_snp_credits := 16;
  int init_dat_credits := 32;
  int init_dat_credits_shared := 16;
  int init_misc_credits := 8;

  // NoC-side message buffers (connected to Ruby network)
  MessageBuffer * reqOut,  network="To", virtual_network="0",
                           vnet_type="none";
  MessageBuffer * snpOut,  network="To", virtual_network="1",
                           vnet_type="none";
  MessageBuffer * rspOut,  network="To", virtual_network="2",
                           vnet_type="none";
  MessageBuffer * datOut,  network="To", virtual_network="3",
                           vnet_type="response";

  MessageBuffer * reqIn,   network="From", virtual_network="0",
                           vnet_type="none";
  MessageBuffer * snpIn,   network="From", virtual_network="1",
                           vnet_type="none";
  MessageBuffer * rspIn,   network="From", virtual_network="2",
                           vnet_type="none";
  MessageBuffer * datIn,   network="From", virtual_network="3",
                           vnet_type="response";

  // C2C-side message buffers (point-to-point, not on Ruby network)
  MessageBuffer * c2cTxReq;
  MessageBuffer * c2cTxSnp;
  MessageBuffer * c2cTxRsp;
  MessageBuffer * c2cTxDat;

  MessageBuffer * c2cRxReq;
  MessageBuffer * c2cRxSnp;
  MessageBuffer * c2cRxRsp;
  MessageBuffer * c2cRxDat;

  // MISC channel (IHI0098A B4.8: DVM/barrier/sync messages)
  MessageBuffer * c2cTxMisc;
  MessageBuffer * c2cRxMisc;

  // Internal queues
  MessageBuffer * triggerQueue;
  MessageBuffer * retryTriggerQueue;
  MessageBuffer * reqRdy;

{

  ////////////////////////////////////////////////////////////////////////////
  // Interface-level state enums (Phase 5)
  ////////////////////////////////////////////////////////////////////////////

  enumeration(InterfaceState, desc="C2C interface state") {
    IF_STOP,        desc="Interface stopped, no traffic permitted";
    IF_ACTIVATE,    desc="Activation handshake in progress";
    IF_RUN,         desc="Interface fully active";
    IF_DEACTIVATE,  desc="Deactivation in progress, drain only";
  }

  enumeration(CoherencyState, desc="Coherency domain state") {
    COH_DISABLED,   desc="Not participating in coherency";
    COH_CONNECT,    desc="Coherency connection handshake in progress";
    COH_ENABLED,    desc="Fully coherent, protocol traffic allowed";
    COH_DISCONNECT, desc="Disconnection in progress, drain outstanding";
  }

  enumeration(DVMDomainState, desc="DVM domain state") {
    DVM_DISABLED,   desc="DVM domain disconnected";
    DVM_CONNECT,    desc="DVM connection handshake in progress";
    DVM_ENABLED,    desc="DVM domain active";
    DVM_DISCONNECT, desc="DVM disconnection in progress";
  }

  // Controller-level guard variables (instant-init defaults per D8)
  // dvmState default matches dvm_support param default (true)
  InterfaceState interfaceState,
      default="CHI_C2C_InterfaceState_IF_RUN";
  CoherencyState cohState,
      default="CHI_C2C_CoherencyState_COH_ENABLED";
  DVMDomainState dvmState,
      default="CHI_C2C_DVMDomainState_DVM_ENABLED";

  ////////////////////////////////////////////////////////////////////////////
  // States
  ////////////////////////////////////////////////////////////////////////////

  state_declaration(State, default="CHI_C2C_State_I") {
    // Default: no active transaction
    I,                 AccessPermission:Invalid,
        desc="No active transaction for this address";

    // Merged bidirectional states (HR-4: outbound+inbound share state,
    // direction tracked via tbe.isOutbound + _Out/_In event split)
    REQ_ACTIVE,        AccessPermission:Busy,
      desc="Request active (outbound fwd'd to C2C, inbound fwd'd to HN)";
    ACTIVE_WAIT_SEP,   AccessPermission:Busy,
      desc="Separated read partially received, waiting for remaining half";
    WR_ACTIVE_DBID,    AccessPermission:Busy,
        desc="Write request sent, waiting for DBIDResp and/or Comp";
    COMPACK_ACTIVE,    AccessPermission:Busy,
        desc="Waiting for CompAck (outbound from local RN, inbound from remote)";
    COMPACK_DL_ACTIVE, AccessPermission:Busy,
      desc="CompAck-required dataless request waiting for Comp";
    COMP_ONLY_DL_ACTIVE, AccessPermission:Busy,
      desc="Comp-only dataless request waiting for terminal Comp";
    ATOMIC_ACTIVE,     AccessPermission:Busy,
        desc="Atomic active, waiting for response (either direction)";

    // Unified post-DBID write state. DBIDResp and Comp are unordered, so
    // this state may still be waiting for data, Comp, or both.
    WR_WAIT_COMP,      AccessPermission:Busy,
      desc="Write DBID seen, waiting for remaining data and/or Comp";

    // Unified retry-wait state for inbound flows. The original state to
    // resume is carried in tbe.retryState because RetryAck and PCrdGrant can
    // arrive in either order.
    RETRY_WAIT,        AccessPermission:Busy,
        desc="Inbound retry waiting for PCrdGrant";

    // Snoop path
    SNP_WAIT_RESP,     AccessPermission:Busy,
        desc="Snoop awaiting response/data (either direction)";

    // DVM originator path (local MN -> C2CG -> remote MN)
    DVM_WAIT_P2,       AccessPermission:Busy,
        desc="DVM originator: received P1, waiting for P2";
    DVM_WAIT_DBID,     AccessPermission:Busy,
        desc="DVM originator: DvmOp sent, waiting for DBIDResp";
    DVM_WAIT_COMP,     AccessPermission:Busy,
        desc="DVM originator: NCBWrData sent, waiting for Comp";

    // WritePush path (source C2CG combines req+data)
    WR_PUSH_WAIT_DATA, AccessPermission:Busy,
        desc="WritePush: request buffered, waiting for WriteData";
    WR_PUSH_SENT,      AccessPermission:Busy,
        desc="WritePush: WrReqData sent, waiting for Comp";

    // WritePush receiver path (peer splits WrReqData)
    WR_PUSH_FWD_WAIT_DBID, AccessPermission:Busy,
      desc="WritePush rcv: waiting for die-local DBID and/or Comp; C2C only sees Comp";
    WR_PUSH_FWD_WAIT_COMP, AccessPermission:Busy,
      desc="WritePush rcv: data sent to HN, waiting for any remaining die-local Comp";
  }


  ////////////////////////////////////////////////////////////////////////////
  // Events
  ////////////////////////////////////////////////////////////////////////////

  enumeration(Event, desc="C2C Gateway events") {
    // TBE allocation events from NoC
    CheckAllocTBE,               desc="Check TBE avail for new request";
    CheckAllocTBE_WithCredit,    desc="Alloc TBE with pre-granted credit";

    // Outbound request events (local NoC -> C2C)
    OutReq_Read,                 desc="Read request for remote address";
    OutReq_MergeReadShared,      desc="Merge local ReadShared with active read";
    OutReq_CleanUnique,          desc="CleanUnique for remote address";
    OutReq_WriteUniqueFull,      desc="WriteUniqueFull for remote";
    OutReq_WriteUniquePtl,       desc="WriteUniquePtl for remote";
    OutReq_WriteBackFull,        desc="WriteBackFull for remote";
    OutReq_WriteCleanFull,       desc="WriteCleanFull for remote";
    OutReq_WriteEvictFull,       desc="WriteEvictFull for remote";
    OutReq_WriteNoSnpFull,       desc="WriteNoSnpFull for remote";
    OutReq_WriteNoSnpPtl,        desc="WriteNoSnpPtl for remote";
    OutReq_WritePull,            desc="Write via WritePull (push disabled)";
    OutReq_WriteCleanNoPush,     desc="WriteCleanFull with WritePush disabled";
    OutReq_Evict,                desc="Evict for remote";
    OutReq_AtomicStore,          desc="AtomicNoReturn for remote";
    OutReq_AtomicLoad,           desc="AtomicReturn for remote";

    // Inbound request events (C2C -> local NoC)
    InReq_Read,                  desc="Inbound read from remote";
    InReq_Write,                 desc="Inbound write from remote";
    InReq_EvictWrite,            desc="Inbound evict/clean write from remote";
    InReq_CleanUnique,           desc="Inbound CleanUnique from remote";
    InReq_Evict,                 desc="Inbound Evict from remote";
    InReq_Atomic,                desc="Inbound atomic from remote";

    // Snoop events
    OutSnp_Forward,              desc="Snoop from local HN to forward";
    OutSnp_DvmP1,                desc="SnpDvmOp_P1 from local MN";
    OutSnp_DvmP2,                desc="SnpDvmOp_P2 from local MN";
    InSnp_Deliver,               desc="Inbound snoop to deliver locally";

    // Response events — non-directional (used by DVM/snoop paths)
    RspIn_Comp,                  desc="Comp response received (DVM/legacy)";
    RspIn_CompDBIDResp,          desc="CompDBIDResp received (DVM/legacy)";
    RspIn_DBIDResp,              desc="DBIDResp received (DVM/legacy)";
    RspIn_CompAck,               desc="CompAck received (legacy)";
    RspIn_ReadReceipt,           desc="ReadReceipt received (legacy)";
    RspIn_RespSepData,           desc="RespSepData (split comp) received (legacy)";
    RspIn_SnpResp_Out,           desc="Final snoop response from C2C RX";
    RspIn_SnpResp_More_Out,      desc="Non-final snoop response from C2C RX";
    RspIn_SnpResp_In,            desc="Final snoop response from local NoC";
    RspIn_SnpResp_More_In,       desc="Non-final snoop response from local NoC";

    // Response events — directional (_Out = C2C RX or outbound context,
    //                               _In  = NoC RSP or inbound context)
    RspIn_Comp_Out,              desc="Comp from C2C RX (outbound: return RSP credit)";
    RspIn_Comp_In,               desc="Comp from local HN (inbound: consume RSP credit)";
    RspIn_CompDBIDResp_Out,      desc="CompDBIDResp from C2C RX (outbound)";
    RspIn_CompDBIDResp_In,       desc="CompDBIDResp from local HN (inbound)";
    RspIn_DBIDResp_Out,          desc="DBIDResp from C2C RX (outbound)";
    RspIn_DBIDResp_In,           desc="DBIDResp from local HN (inbound)";
    RspIn_CompAck_Out,           desc="CompAck from local RN via NoC (outbound: fwd to C2C)";
    RspIn_CompAck_In,            desc="CompAck from remote RN via C2C (inbound: fwd to HN)";
    RspIn_ReadReceipt_Out,       desc="ReadReceipt from C2C RX (outbound)";
    RspIn_ReadReceipt_In,        desc="ReadReceipt from local SNF (inbound)";
    RspIn_RespSepData_Out,       desc="RespSepData from C2C RX (outbound)";
    RspIn_RespSepData_In,        desc="RespSepData from local HN (inbound)";
    RspIn_SepReadResp_Done_Out,  desc="RespSepData completes separated outbound read";
    RspIn_SepReadResp_Done_In,   desc="RespSepData completes separated inbound read";
    RspIn_RetryCompWrite_In,     desc="Comp completing retried inbound write";
    RspIn_RetryCompWritePush_In, desc="Comp completing retried inbound WritePush receiver";
        RspIn_StaleRetryCompDBIDResp_In,
          desc="Stale CompDBIDResp observed while retrying inbound request";
    RspIn_RetryCompAckDataless_In,
             desc="Comp completing retried CompAck-gated dataless request";
    RspIn_RetryCompOnlyDataless_In,
             desc="Comp completing retried Comp-only dataless request";
    RspIn_RetryCompAtomic_In,    desc="Comp completing retried inbound atomic";

    // Data events — non-directional (used by WrReqData)
    DatIn_WrReqData,             desc="WrReqDataS/L received from C2C";

    // Data events — directional
    DatIn_SnpRespData_Out,       desc="Final SnpRespData from C2C RX";
    DatIn_SnpRespData_More_Out,  desc="Non-final SnpRespData from C2C RX";
    DatIn_SnpRespData_In,        desc="Final SnpRespData from local NoC";
    DatIn_SnpRespData_More_In,   desc="Non-final SnpRespData from local NoC";
    DatIn_CompData_Out,          desc="CompData from C2C RX (outbound read response)";
    DatIn_CompData_In,           desc="CompData from local HN (inbound read response)";
    DatIn_RetryCompDataReq_In,   desc="CompData completing retried inbound read";
    DatIn_RetryCompDataAtomic_In,
             desc="CompData completing retried inbound atomic";
    DatIn_DataSepResp_Out,       desc="DataSepResp from C2C RX (outbound)";
    DatIn_DataSepResp_In,        desc="DataSepResp from local HN (inbound)";
    DatIn_SepReadData_More_Out,  desc="More separated read data from C2C RX before RespSepData";
    DatIn_SepReadData_More_In,   desc="More separated read data from local HN before RespSepData";
    DatIn_SepReadData_Done_Out,  desc="DataSepResp completes separated outbound read";
    DatIn_SepReadData_Done_In,   desc="DataSepResp completes separated inbound read";
    DatIn_CBWrData_Out,          desc="CBWrData from local RN via NoC (outbound write)";
    DatIn_CBWrData_In,           desc="CBWrData from remote via C2C RX (inbound write)";
    DatIn_NCBWrData_Out,         desc="NCBWrData from local RN via NoC (outbound)";
    DatIn_NCBWrData_In,          desc="NCBWrData from remote via C2C RX (inbound)";

    // Retry handling
    RetryAckFromHN,              desc="RetryAck from local HN (absorb)";
    PCrdGrantFromHN,             desc="PCrdGrant from local HN";
    PCrdGrantRetryReqFromHN,     desc="PCrdGrant resumes retried request";
    PCrdGrantRetryWriteFromHN,   desc="PCrdGrant resumes retried write";
    PCrdGrantRetryCompAckDatalessFromHN,
         desc="PCrdGrant resumes retried CompAck-gated dataless request";
    PCrdGrantRetryCompOnlyDatalessFromHN,
         desc="PCrdGrant resumes retried Comp-only dataless request";
    PCrdGrantRetryAtomicFromHN,  desc="PCrdGrant resumes retried atomic";
    PCrdGrantRetryWritePushFromHN,
         desc="PCrdGrant resumes retried WritePush receiver";
    EarlyPCrdGrantFromHN,        desc="PCrdGrant from local HN before RetryAck";
    RetryAckAfterPCrdGrantFromHN, desc="RetryAck from local HN after PCrdGrant";
    SendRetryAck,                desc="Send RetryAck to requester";
    SendPCrdGrant,               desc="Send PCrdGrant to requester";

    // Internal completion trigger
    CompleteTxn,                 desc="All flits done, deallocate TBE";
  }


  ////////////////////////////////////////////////////////////////////////////
  // Data structures
  ////////////////////////////////////////////////////////////////////////////

  // Cache block size
  int blockSize, default="m_ruby_system->getBlockSizeBytes()";
    Addr nextTxnID, default="1";

  // TBE: Transaction Buffer Entry
  structure(TBE, desc="C2C Gateway Transaction Buffer Entry") {
    int storSlot,               desc="Slot in storage tracker";
    Addr addr,                  desc="Cache line address";
    State state,                desc="Current SLICC state";
    CHIRequestType reqType,     desc="Original request type";
    bool isRead,                desc="Is read transaction";
    bool isWrite,               desc="Is write transaction";
    bool isSnoop,               desc="Is snoop forwarding";
    bool isDVM,                 desc="Is DVM transaction";
    bool isDataless,            desc="Is dataless transaction";
    bool isAtomic,              desc="Is atomic transaction";
    MachineID localSrcID,       desc="Local source MachineID";
    MachineID localFwdRequestor, desc="Original forward requestor from local ingress";
    MachineID localDest,        desc="Local destination selected by route metadata";
    Addr localTxnID,            desc="Local TxnID";
    Addr txnID,                 desc="TxnID used when forwarding to local HN";
    MachineID remoteSrcID,      desc="Remote source MachineID";
    Addr remoteTxnID,           desc="Remote TxnID";
    MachineID peerC2CG,         desc="Peer C2CG on remote chip";
    bool hasC2CEgressType,      desc="Outbound request carries C2C egress type";
    MachineType c2cEgressType,  desc="Outbound C2C egress type";
    bool expectingData,         desc="Waiting for separated read data";
    bool expectingComp,         desc="Waiting for separated read response";
    int pendingSnpResps,        desc="Outstanding snoop responses";
    int c2cSnpResponsesToForward,
      desc="Inbound snoop responses to forward back over C2C";
    NetDest c2cSnpForwardDests,
      desc="Original local snoop responders to forward back over C2C";
    NetDest snpDataRespondersSeen,
      desc="Snoop data responders already counted";
    bool retryPending,          desc="HN sent RetryAck";
    bool retryGrantPending,     desc="HN sent PCrdGrant";
    State retryState,           desc="State to resume after PCrdGrant";
    bool writeCompReceived,     desc="Write-side Comp has been observed";
    int resPlane,               desc="Resource Plane assignment";
    bool usedSharedCredit,      desc="Used shared credit pool";
    Tick allocTime,             desc="Cycle when allocated";
    DataBlock dataBlk,          desc="Transaction data buffer";
    WriteMask dataBlkValid,     desc="Valid bytes in data buffer";
    int rxtxBytes,              desc="Bytes sent or received";
    bool compAckDone,           desc="CompAck forwarded, awaiting data";
    int pendingCompAcks,        desc="Requester CompAcks still expected";
    NetDest readFanoutDests,    desc="Local destinations for merged reads";
    bool dataToFwdRequestor,     desc="Forward response data to fwdRequestor";
    bool isOutbound,            desc="True=outbound (local→remote), false=inbound";
  }

  // TBE table for request transactions
  structure(TBETable, external="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
    bool areNSlotsAvailable(int n, Tick curTime);
  }

  structure(TBEStorage, external="yes") {
    int size();
    int capacity();
    int reserved();
    int slotsAvailable();
    bool areNSlotsAvailable(int n);
    void incrementReserved();
    void decrementReserved();
    int addEntryToNewSlot();
    void removeEntryFromSlot(int slot);
  }

  TBETable TBEs, template="<CHI_C2C_TBE>",
      constructor="m_number_of_TBEs";
  TBEStorage storTBEs,
      constructor='this, m_number_of_TBEs, "TBEs"';

  // C2C Credit Manager (Phase 3)
  structure(C2CCreditManager, external="yes") {
    bool hasReqCredit(int rp);
    bool hasRspCredit();
    bool hasSnpCredit();
    bool hasDatCredit();
    bool consumeReqCredit(int rp);
    void consumeRspCredit();
    void consumeSnpCredit();
    bool consumeDatCredit();
    void returnReqCredit();
    void returnRspCredit();
    void returnSnpCredit();
    void returnDatCredit();
    void recordStall(int cls);
  }

  C2CCreditManager creditMgr,
      constructor='this, m_num_resource_planes, m_init_req_credits_per_rp, m_init_req_credits_shared, m_init_rsp_credits, m_init_snp_credits, m_init_dat_credits, m_init_dat_credits_shared, m_init_misc_credits';

  structure(C2CReadMergeTable, external="yes") {
    void addSharers(Addr, NetDest);
    NetDest expandSharers(Addr, NetDest);
  }

  C2CReadMergeTable readMergeTable,
      constructor='this';

  structure(C2CTxnKeyTable, external="yes") {
    void bindC2COut(Addr, Addr);
    bool hasC2COut(Addr);
    Addr lookupC2COut(Addr);
    void bindC2CInScoped(MachineID, Addr, Addr, Addr);
    bool hasC2CInScoped(MachineID, Addr, Addr);
    Addr lookupC2CInScoped(MachineID, Addr, Addr);
    void bindLocal(MachineID, Addr, Addr, Addr);
    bool hasLocal(MachineID, Addr, Addr);
    Addr lookupLocal(MachineID, Addr, Addr);
    void bindLocalTxn(Addr, Addr);
    bool hasLocalTxn(Addr);
    Addr lookupLocalTxn(Addr);
    void bindAddress(Addr, Addr);
    bool hasAddress(Addr);
    Addr lookupAddress(Addr);
    void eraseKey(Addr);
  }

  C2CTxnKeyTable txnKeyTable,
      constructor='this';

  // Separate TBE table for snoop forwarding (deadlock avoidance)
  TBETable snpTBEs, template="<CHI_C2C_TBE>",
      constructor="m_number_of_snoop_TBEs";
  TBEStorage storSnpTBEs,
      constructor='this, m_number_of_snoop_TBEs, "snpTBEs"';

  // Separate TBE table for DVM originator (addr = txnId collision avoidance)
  TBETable dvmTBEs, template="<CHI_C2C_TBE>",
      constructor="m_number_of_dvm_TBEs";
  TBEStorage storDvmTBEs,
      constructor='this, m_number_of_dvm_TBEs, "dvmTBEs"';

  // Retry queue
  structure(RetryQueueEntry) {
    Addr addr,           desc="Line address";
    MachineID retryDest, desc="Retry destination";
  }

  structure(TriggerQueue, external="yes") {
    void pop();
    bool empty();
    void emplace(Addr, MachineID);
    RetryQueueEntry next();
  }

  TriggerQueue retryQueue, template="<CHI_C2C_RetryQueueEntry>";

  // Internal trigger message types
  structure(TriggerMsg, desc="Internal trigger", interface="Message") {
    Addr addr;
    Addr tbeKey;
    Event event;
    bool functionalRead(Packet *pkt) { return false; }
    bool functionalRead(Packet *pkt, WriteMask &mask) { return false; }
    bool functionalWrite(Packet *pkt) { return false; }
  }

  structure(RetryTriggerMsg, desc="Retry trigger", interface="Message") {
    Addr addr;
    Event event;
    MachineID retryDest;
    bool functionalRead(Packet *pkt) { return false; }
    bool functionalRead(Packet *pkt, WriteMask &mask) { return false; }
    bool functionalWrite(Packet *pkt) { return false; }
  }


  ////////////////////////////////////////////////////////////////////////////
  // Protocol-level counters (T-011)
  ////////////////////////////////////////////////////////////////////////////

  int outboundReqCount, default="0";
  int inboundReqCount,  default="0";
  int snpForwardCount,  default="0";
  int retryAbsorbCount, default="0";
  int tbeFullRetries,   default="0";
  int writePushCount,   default="0";
  int dvmReqsSent,      default="0";
  int readMergeAttachCount, default="0";
  // Per-transaction latency tracking (FR-C03)
  // txnLatencySum / txnLatencyCount gives average latency in ticks
  int txnLatencyCount,  default="0";
  Tick txnLatencySum,   default="0";
  Tick txnLatencyMin,   default="0xFFFFFFFFFFFFFFFF";
  Tick txnLatencyMax,   default="0";

  // Per-message-type traffic counters (EX-012)
  // *_c2c: messages crossing the C2C link (tracked in C2CPacketizerBridge)
  // *_onchip: messages forwarded between C2CG and local chip network
  // req_onchip: inbound REQ forwarded from C2CG to local HNF
  int req_onchip,  default="0";
  // snp_onchip: SNP forwarded between C2CG and local RNFs
  int snp_onchip,  default="0";
  // rsp_onchip: RSP forwarded between C2CG and local network
  int rsp_onchip,  default="0";
  // dat_onchip: DAT forwarded between C2CG and local network
  int dat_onchip,  default="0";

  ////////////////////////////////////////////////////////////////////////////
  // Port definitions (includes funcs.sm for helpers)
  ////////////////////////////////////////////////////////////////////////////

  include "CHI-c2c-ports.sm";
  // CHI-c2c-ports.sm includes CHI-c2c-funcs.sm

  ////////////////////////////////////////////////////////////////////////////
  // Action definitions (must come after in_port declarations)
  ////////////////////////////////////////////////////////////////////////////

  include "CHI-c2c-actions.sm";

  ////////////////////////////////////////////////////////////////////////////
  // Transition table
  ////////////////////////////////////////////////////////////////////////////

  include "CHI-c2c-transitions.sm";
}
